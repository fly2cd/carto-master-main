{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.itinerary-tools.local/v1/itinerary-assemble-response.schema.json",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "enum": [
        "assembled",
        "error"
      ]
    },
    "output_path": {
      "type": "string"
    },
    "output_digest": {
      "type": "string"
    },
    "counts": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "code": {
      "type": "string"
    },
    "message": {
      "type": "string"
    }
  }
}
