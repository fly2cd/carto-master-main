{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/raster-classification-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source",
    "legend",
    "palette",
    "legend_policy"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source": {
      "$ref": "https://schemas.carto-agent.local/v1/raster-input.schema.json"
    },
    "legend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "size_bytes",
        "encoding",
        "value_column",
        "label_column",
        "color_column"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "digest": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "encoding": {
          "enum": [
            "utf-8-sig"
          ]
        },
        "value_column": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "label_column": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]+$"
        },
        "color_column": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\x00-\\x1f\\x7f]+$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "palette": {
      "enum": [
        null,
        "carto-categorical-v1"
      ]
    },
    "legend_policy": {
      "enum": [
        "observed",
        "all"
      ]
    }
  }
}
