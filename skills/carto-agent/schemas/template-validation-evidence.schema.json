{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/template-validation-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "namespace",
    "package_ref",
    "manifest_digest",
    "dependency_lock_digest",
    "fixture_set_digest",
    "checker_set_digest",
    "status",
    "counts",
    "results",
    "created_at",
    "evidence_digest"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"
    },
    "evidence_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "namespace": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "package_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/templateRef"
    },
    "manifest_digest": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
    },
    "dependency_lock_digest": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
    },
    "fixture_set_digest": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
    },
    "checker_set_digest": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderer_id",
        "renderer_profile_digest",
        "adapter_version",
        "frontend_build",
        "renderer_version",
        "maplibre_version",
        "overlay_engine_version",
        "environment_fingerprint"
      ],
      "properties": {
        "renderer_id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "renderer_profile_digest": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
        },
        "adapter_version": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
        },
        "frontend_build": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "renderer_version": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
        },
        "maplibre_version": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
        },
        "overlay_engine_version": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
        },
        "environment_fingerprint": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
        }
      }
    },
    "render_receipt_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "preview_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "artifact_ref"
        ],
        "properties": {
          "target": {
            "enum": [
              "svg",
              "png",
              "pdf"
            ]
          },
          "artifact_ref": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
          }
        }
      }
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ]
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocker",
        "error",
        "warning",
        "info"
      ],
      "properties": {
        "blocker": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "integer",
          "minimum": 0
        },
        "warning": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "check_id",
          "version",
          "status",
          "severity",
          "details"
        ],
        "properties": {
          "check_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/checkerRef/properties/id"
          },
          "version": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
          },
          "status": {
            "enum": [
              "passed",
              "failed"
            ]
          },
          "severity": {
            "enum": [
              "blocker",
              "error",
              "warning",
              "info"
            ]
          },
          "details": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "created_at": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"
    },
    "evidence_digest": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "passed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "renderer",
          "render_receipt_ref",
          "preview_artifacts"
        ],
        "properties": {
          "counts": {
            "properties": {
              "blocker": {
                "const": 0
              },
              "error": {
                "const": 0
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "counts": {
            "anyOf": [
              {
                "properties": {
                  "blocker": {
                    "minimum": 1
                  }
                }
              },
              {
                "properties": {
                  "error": {
                    "minimum": 1
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
