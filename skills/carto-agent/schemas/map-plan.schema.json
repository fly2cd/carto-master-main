{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v4/map-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "revision",
    "project_id",
    "intent_ref",
    "brief_ref",
    "business_scene",
    "tasks",
    "template_refs",
    "data_bindings",
    "decisions",
    "open_issues",
    "theme_tags"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "plan_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "intent_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "brief_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "business_scene": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/businessSceneId"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
      }
    },
    "template_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/templateRef"
      }
    },
    "data_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "dataset_ref"
        ],
        "properties": {
          "role": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "dataset_ref": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
          }
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "renderer_id"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "legend_source": {
          "const": "actual-encoding"
        },
        "renderer_id": {
          "enum": [
            "maplibre-web",
            "rasterio-matplotlib-page",
            "matplotlib-vector-page",
            "image-itinerary-page"
          ]
        },
        "legend_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "thematic_views": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "view_id",
              "source_id",
              "data_ref",
              "design",
              "encoding",
              "statistics",
              "expression_ref"
            ],
            "properties": {
              "view_id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "source_id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "data_ref": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
              },
              "design": {
                "$ref": "https://schemas.carto-agent.local/v1/thematic-design.schema.json"
              },
              "encoding": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "https://schemas.carto-agent.local/v1/encoding-ir.schema.json"
                  }
                ]
              },
              "statistics": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "count",
                      "minimum",
                      "maximum"
                    ],
                    "properties": {
                      "count": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "minimum": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "maximum": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  }
                ]
              },
              "expression_ref": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/mapExpressionRef"
              }
            }
          }
        },
        "extent": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          },
          "description": "Image-itinerary plans: geographic bbox derived from the basemap registration."
        },
        "canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width_mm",
            "height_mm",
            "dpi"
          ],
          "properties": {
            "width_mm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1200
            },
            "height_mm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1200
            },
            "dpi": {
              "type": "integer",
              "minimum": 72,
              "maximum": 600
            }
          }
        },
        "basemap_ref": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
        },
        "layout_model": {
          "enum": [
            "image-native",
            "fixed-page"
          ]
        },
        "annotation_layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "seed",
            "iterations",
            "gap_px"
          ],
          "properties": {
            "seed": {
              "type": "integer"
            },
            "iterations": {
              "type": "integer",
              "minimum": 1
            },
            "gap_px": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "theme_tags": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/themeTags"
    },
    "components": {
      "description": "P6 field-mapping I.components[id] / J[id]: adopted component instances keyed by stable id. component_ref pins a registered C[type] definition; parameters MUST validate at runtime against that definition's parameter_schema (closed, e.g. card-parameters) — this is not an open extension bag. structure_mode is one of the definition's admitted modes. preset_ref optionally pins the adopted default preset expanded before compile.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_ref", "structure_mode", "parameters"],
        "properties": {
          "component_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"},
          "structure_mode": {"type": "string", "minLength": 1},
          "parameters": {"type": "object", "minProperties": 1},
          "preset_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"}
        }
      }
    },
    "annotations": {
      "description": "P6 field-mapping I.annotations[id] / N[id]: instance annotation placement selections keyed by id. component_ref pins the annotation component; anchor_ref binds the data-derived geographic anchor (never modified by placement); placement carries preferred/fixed semantics.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component_ref", "anchor_ref", "placement"],
        "properties": {
          "component_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"},
          "anchor_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"},
          "placement": {"$ref": "https://schemas.carto-agent.local/v1/annotation-placement.schema.json"}
        }
      }
    },
    "content": {
      "description": "P6 field-mapping I.content: adopted display content selections under scenario required/allowed constraints. card.fields lists chosen content roles (e.g. arrival-time, M25); numbering.display_order is the display-order rule (M39), distinct from the visit_order fact.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "card": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fields"],
          "properties": {
            "fields": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}}
          }
        },
        "numbering": {
          "type": "object",
          "additionalProperties": false,
          "required": ["display_order"],
          "properties": {
            "display_order": {"enum": ["per-date-group", "global"]}
          }
        }
      }
    },
    "group_bindings": {
      "description": "P6 field-mapping I.group_bindings (M02/M04): explicit binding of a business semantic_group to a Style visual_role (color) and optional route_role (display offset). The consumer resolves roles via these declared bindings, never by concatenating the business group name into a Style role name. Duplicate/missing/dangling bindings are refused at resolution.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["semantic_group", "visual_role"],
        "properties": {
          "semantic_group": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
          "visual_role": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
          "route_role": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}
        }
      }
    },
    "legend_labels": {
      "description": "P6 field-mapping I.legend_labels[group] (M03): adopted legend display labels keyed by business group; generated from the actual mapping, not a separate hand-maintained color/label table.",
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "group_resolution": {
      "description": "P6 field-mapping I.group_resolution (M06): the adopted allowed fallback for missing group values. Unknown non-empty groups are still refused; this does not covertly decide legend color.",
      "type": "object",
      "additionalProperties": false,
      "required": ["fallback_group"],
      "properties": {
        "fallback_group": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}
      }
    },
    "basemap_display": {
      "description": "P6 field-mapping V[id] (M40): per-view basemap display contracts keyed by view id (crop/window strategy), distinct from source facts.",
      "type": "object",
      "additionalProperties": {"$ref": "https://schemas.carto-agent.local/v1/basemap-display.schema.json"}
    },
    "bindings": {
      "$ref": "https://schemas.carto-agent.local/v2/page-bindings.schema.json"
    },
    "layout_parameters": {
      "$ref": "https://schemas.carto-agent.local/v1/grid-parameters.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decisions": {
            "properties": {
              "renderer_id": {
                "const": "image-itinerary-page"
              }
            }
          }
        },
        "required": [
          "decisions"
        ]
      },
      "then": {
        "properties": {
          "decisions": {
            "required": [
              "extent",
              "canvas",
              "basemap_ref"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "bindings"
              ]
            },
            {
              "required": [
                "layout_parameters"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "bindings",
          "layout_parameters"
        ],
        "properties": {
          "decisions": {
            "required": [
              "legend_source",
              "legend_capacity",
              "thematic_views"
            ]
          }
        }
      }
    }
  ]
}
