{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v3/map-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "revision",
    "project_id",
    "intent_ref",
    "brief_ref",
    "business_scene",
    "tasks",
    "template_refs",
    "data_bindings",
    "decisions",
    "open_issues",
    "theme_tags"
  ],
  "properties": {
    "schema_version": {
      "const": 3
    },
    "plan_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "intent_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "brief_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "business_scene": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/businessSceneId"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
      }
    },
    "template_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/templateRef"
      }
    },
    "data_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "dataset_ref"
        ],
        "properties": {
          "role": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "dataset_ref": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
          }
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "title",
        "legend_source",
        "renderer_id"
      ],
      "properties": {
        "classification": {
          "enum": [
            "quantile",
            "unique-values",
            "explicit-vector"
          ]
        },
        "class_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 256
        },
        "extent": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/bbox"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "legend_source": {
          "const": "actual-encoding"
        },
        "renderer_id": {
          "enum": [
            "maplibre-web",
            "rasterio-matplotlib-page",
            "matplotlib-vector-page"
          ]
        },
        "point_scaling": {
          "const": "area-proportional"
        },
        "category_counts": {
          "$ref": "https://schemas.carto-agent.local/v1/category-counts.schema.json"
        },
        "legend_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "data_statistics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_id",
              "counts"
            ],
            "properties": {
              "source_id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "counts": {
                "$ref": "https://schemas.carto-agent.local/v1/category-counts.schema.json"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "const": "unique-values"
              }
            }
          },
          "then": {
            "required": [
              "data_statistics",
              "legend_capacity"
            ],
            "properties": {
              "class_count": false,
              "category_counts": false,
              "extent": false
            }
          },
          "else": {
            "if": {
              "properties": {
                "classification": {
                  "const": "explicit-vector"
                }
              }
            },
            "then": {
              "required": [
                "legend_capacity"
              ],
              "properties": {
                "class_count": false,
                "category_counts": false,
                "data_statistics": false,
                "extent": false
              }
            },
            "else": {
              "required": [
                "class_count",
                "extent"
              ],
              "properties": {
                "category_counts": false,
                "legend_capacity": false
              }
            }
          }
        }
      ]
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "theme_tags": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/themeTags"
    },
    "bindings": {
      "$ref": "https://schemas.carto-agent.local/v2/page-bindings.schema.json"
    },
    "layout_parameters": {
      "$ref": "https://schemas.carto-agent.local/v1/grid-parameters.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decisions": {
            "properties": {
              "classification": {
                "const": "unique-values"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "bindings",
          "layout_parameters"
        ]
      }
    }
  ]
}
