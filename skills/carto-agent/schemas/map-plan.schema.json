{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v4/map-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "revision",
    "project_id",
    "intent_ref",
    "brief_ref",
    "business_scene",
    "tasks",
    "template_refs",
    "data_bindings",
    "decisions",
    "open_issues",
    "theme_tags",
    "bindings",
    "layout_parameters"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "plan_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "intent_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "brief_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "business_scene": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/businessSceneId"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
      }
    },
    "template_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/templateRef"
      }
    },
    "data_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "dataset_ref"
        ],
        "properties": {
          "role": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "dataset_ref": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
          }
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "legend_source",
        "renderer_id",
        "legend_capacity",
        "thematic_views"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "legend_source": {
          "const": "actual-encoding"
        },
        "renderer_id": {
          "enum": [
            "maplibre-web",
            "rasterio-matplotlib-page",
            "matplotlib-vector-page"
          ]
        },
        "legend_capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "thematic_views": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "view_id",
              "source_id",
              "data_ref",
              "design",
              "encoding",
              "statistics",
              "expression_ref"
            ],
            "properties": {
              "view_id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "source_id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "data_ref": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
              },
              "design": {
                "$ref": "https://schemas.carto-agent.local/v1/thematic-design.schema.json"
              },
              "encoding": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "https://schemas.carto-agent.local/v1/encoding-ir.schema.json"
                  }
                ]
              },
              "statistics": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "count",
                      "minimum",
                      "maximum"
                    ],
                    "properties": {
                      "count": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "minimum": {
                        "type": [
                          "number",
                          "null"
                        ]
                      },
                      "maximum": {
                        "type": [
                          "number",
                          "null"
                        ]
                      }
                    }
                  }
                ]
              },
              "expression_ref": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/mapExpressionRef"
              }
            }
          }
        }
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "theme_tags": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/themeTags"
    },
    "bindings": {
      "$ref": "https://schemas.carto-agent.local/v2/page-bindings.schema.json"
    },
    "layout_parameters": {
      "$ref": "https://schemas.carto-agent.local/v1/grid-parameters.schema.json"
    }
  }
}
