{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/map-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "revision",
    "project_id",
    "intent_ref",
    "brief_ref",
    "business_scene",
    "tasks",
    "template_refs",
    "data_bindings",
    "decisions",
    "open_issues",
    "theme_tags"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"
    },
    "plan_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "intent_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "brief_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "business_scene": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/businessSceneId"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
      }
    },
    "template_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/templateRef"
      }
    },
    "data_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "dataset_ref"
        ],
        "properties": {
          "role": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "dataset_ref": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
          }
        }
      }
    },
    "decisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "class_count",
        "extent",
        "title",
        "legend_source",
        "renderer_id"
      ],
      "properties": {
        "classification": {
          "enum": ["quantile", "unique-values"]
        },
        "class_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 256
        },
        "extent": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/bbox"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "legend_source": {
          "const": "actual-encoding"
        },
        "renderer_id": {
          "enum": ["maplibre-web", "rasterio-matplotlib-page"]
        },
        "point_scaling": {
          "const": "area-proportional"
        }
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "theme_tags": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/themeTags"
    }
  }
}
