{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.carto-agent.local/v1/map-plan.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "plan_id", "revision", "project_id", "intent_ref", "brief_ref", "business_scene", "tasks", "template_refs", "data_bindings", "decisions", "open_issues"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "plan_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}, "revision": {"type": "integer", "minimum": 1},
    "project_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "intent_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"}, "brief_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"},
    "business_scene": {"enum": ["government_thematic", "emergency_mapping", "leadership_visit"]},
    "tasks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}},
    "template_refs": {"type": "array", "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/templateRef"}},
    "data_bindings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["role", "dataset_ref"], "properties": {"role": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}, "dataset_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"}}}},
    "decisions": {"type": "object", "minProperties": 1, "additionalProperties": true},
    "open_issues": {"type": "array", "items": {"type": "string"}}
  }
}
