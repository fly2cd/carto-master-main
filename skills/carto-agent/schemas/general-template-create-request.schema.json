{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/general-template-create-request.schema.json",
  "description": "Strict thematic template overlay. Geometry is explicit; template versions identify assets, never dispatch rules.",
  "properties": {
    "geometry": {
      "enum": [
        "raster",
        "vector"
      ]
    }
  },
  "allOf": [
    {
      "$ref": "https://schemas.carto-agent.local/v1/template-create-request.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "kind": {
          "const": "map-scenario"
        },
        "namespace": {
          "const": "local"
        },
        "template_id": {
          "const": "general-thematic-map"
        },
        "version": {
          "enum": [
            "3.0.0",
            "4.0.0"
          ]
        },
        "profile": {
          "enum": [
            "general-thematic-authoring",
            "general-vector-authoring"
          ]
        },
        "authoring_mode": {
          "const": "standard"
        },
        "targets": {
          "minItems": 2,
          "maxItems": 2,
          "allOf": [
            {
              "contains": {
                "const": "pdf"
              }
            },
            {
              "contains": {
                "const": "png"
              }
            }
          ]
        },
        "data_nature": {
          "const": "user-provided"
        },
        "contains_production_data": {
          "const": false
        },
        "contains_sensitive_coordinates": {
          "const": false
        },
        "geometry": {
          "enum": [
            "raster",
            "vector"
          ]
        },
        "role_bindings": {
          "minProperties": 1,
          "maxProperties": 1
        }
      }
    }
  ],
  "if": {
    "properties": {
      "geometry": {
        "const": "raster"
      }
    },
    "required": [
      "geometry"
    ]
  },
  "then": {
    "properties": {
      "profile": {
        "const": "general-thematic-authoring"
      },
      "role_bindings": {
        "propertyNames": {
          "const": "classified_surface"
        }
      }
    }
  },
  "else": {
    "properties": {
      "profile": {
        "const": "general-vector-authoring"
      },
      "role_bindings": {
        "propertyNames": {
          "const": "thematic_features"
        }
      }
    }
  },
  "required": [
    "geometry"
  ]
}
