{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/design-revision-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "run_id",
    "parent_revision",
    "changes",
    "justification"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"
    },
    "proposal_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "parent_revision": {
      "type": "integer",
      "minimum": 1
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 8,
      "properties": {
        "layout_parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new_value"
          ],
          "properties": {
            "new_value": {
              "type": "object",
              "minProperties": 1
            }
          }
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new_value"
          ],
          "properties": {
            "new_value": {
              "description": "Partial or full style contract applied as revised_cartography (top-level key merge, 裁决4). Validated closed-world against the style schema downstream; unknown keys are rejected there.",
              "type": "object",
              "minProperties": 1,
              "properties": {
                "typography": {
                  "type": "object"
                }
              }
            }
          }
        },
        "color_scheme": {
          "description": "裁决4/6: preview palette revision. A category-contract-scoped value->hex effective-color overlay applied at compile time (baseline prepared colors stay frozen; the bundle is reused). scope is the shared-legend category contract id; colors keyed by category code (data value), never by legend order.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new_value"
          ],
          "properties": {
            "new_value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scope",
                "colors"
              ],
              "properties": {
                "scope": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                },
                "colors": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 256,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "value",
                      "color"
                    ],
                    "properties": {
                      "value": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 4294967295
                      },
                      "color": {
                        "type": "string",
                        "pattern": "^#[0-9A-F]{6}$"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "map_title": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new_value"
          ],
          "properties": {
            "new_value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "panel_designs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new_value"
          ],
          "properties": {
            "new_value": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 4,
              "additionalProperties": {
                "$ref": "https://schemas.carto-agent.local/v1/thematic-design.schema.json"
              }
            }
          }
        }
      }
    },
    "justification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
