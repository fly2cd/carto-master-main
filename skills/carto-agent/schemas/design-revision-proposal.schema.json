{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/design-revision-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "run_id",
    "parent_revision",
    "changes",
    "justification"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"
    },
    "proposal_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "parent_revision": {
      "type": "integer",
      "minimum": 1
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 8,
      "properties": {
        "layout_parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new_value"
          ],
          "properties": {
            "new_value": {
              "type": "object",
              "minProperties": 1
            }
          }
        },
        "cartography": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new_value"
          ],
          "properties": {
            "new_value": {
              "type": "object",
              "minProperties": 1,
              "properties": {
                "typography": {
                  "type": "object"
                },
                "color_scheme": {
                  "type": "object"
                },
                "legend_style": {
                  "type": "object"
                },
                "scale_bar_style": {
                  "type": "object"
                }
              }
            }
          }
        },
        "map_title": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new_value"
          ],
          "properties": {
            "new_value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "annotation_layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new_value"
          ],
          "properties": {
            "new_value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "seed",
                "iterations",
                "gap_px"
              ],
              "properties": {
                "seed": {
                  "type": "integer",
                  "minimum": 0
                },
                "iterations": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "gap_px": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        },
        "page_layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new_value"
          ],
          "properties": {
            "new_value": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "model"
              ],
              "properties": {
                "model": {
                  "enum": [
                    "image-native",
                    "fixed-page"
                  ]
                },
                "width_mm": {
                  "type": "number",
                  "minimum": 100,
                  "maximum": 1200
                },
                "height_mm": {
                  "type": "number",
                  "minimum": 100,
                  "maximum": 1200
                },
                "dpi": {
                  "type": "integer",
                  "minimum": 72,
                  "maximum": 600
                }
              }
            }
          }
        },
        "style_overrides": {
          "description": "Design-layer style patch (leadership-visit): merged onto the template portrayal contract's image_itinerary section at recompile; data evidence stays reusable.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new_value"
          ],
          "properties": {
            "new_value": {
              "$ref": "https://schemas.carto-agent.local/v1/image-itinerary-style-override.schema.json"
            }
          }
        },
        "panel_designs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "new_value"
          ],
          "properties": {
            "new_value": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 4,
              "additionalProperties": {
                "$ref": "https://schemas.carto-agent.local/v1/thematic-design.schema.json"
              }
            }
          }
        }
      }
    },
    "justification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
