{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/material-source.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "format", "origin", "content_ref", "extraction_tool", "extraction_version", "extraction_digest"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "source_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "format": {
      "type": "string",
      "enum": ["text/plain", "text/csv", "text/markdown", "application/json", "image/png", "image/jpeg", "image/tiff", "application/pdf"]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_digest"],
      "properties": {
        "path_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
        "offset_bytes": {"type": "integer", "minimum": 0},
        "length_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "page_number": {"type": "integer", "minimum": 1},
        "sheet_name": {"type": "string", "minLength": 1},
        "cell_range": {"type": "string", "minLength": 1}
      }
    },
    "content_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"},
    "extraction_tool": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "extraction_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"},
    "extraction_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "label": {"type": "string", "minLength": 1, "maxLength": 256},
    "mime_type": {"type": "string", "minLength": 1}
  }
}