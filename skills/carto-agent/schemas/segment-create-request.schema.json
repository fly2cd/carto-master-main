{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/segment-create-request.schema.json",
  "description": "Creation request for an independent segment template (map-style/map-layout). Segments are reusable appearance/layout contracts, not business scenarios: they carry a confirmed design contract and NO data sources, CRS, geometry or role bindings (plan §1.2.4). The design object is validated closed-world against the kind's contract schema (style/layout) by the segment strategy; this request schema closes only its own fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "kind",
    "namespace",
    "template_id",
    "version",
    "purpose",
    "audience",
    "reuse_intent",
    "supported_uses",
    "excluded_uses",
    "authoring_mode",
    "targets",
    "scope",
    "subject",
    "design",
    "requested_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "kind": {"enum": ["map-style", "map-layout"]},
    "namespace": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "template_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 1000},
    "audience": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "reuse_intent": {"type": "string", "minLength": 1, "maxLength": 500},
    "supported_uses": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}
    },
    "excluded_uses": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}
    },
    "authoring_mode": {"enum": ["standard", "fidelity", "mirror"]},
    "targets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["svg", "pdf", "png"]}
    },
    "scope": {"type": "string", "pattern": "^project:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 128},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["tenant_id", "project_id", "requester_subject_id", "approver_subject_id", "environment"],
      "properties": {
        "tenant_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
        "project_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
        "requester_subject_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
        "approver_subject_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
        "environment": {"enum": ["local", "test", "staging", "production"]}
      }
    },
    "design": {
      "description": "Confirmed segment contract (style or layout per kind). Validated against the kind contract schema by the segment strategy.",
      "type": "object", "minProperties": 1
    },
    "source_import": {
      "description": "Optional A->B publication-run source binding (design §8.4). Present only on a deferred publication run B that imports a finished creation run A's immutable draft/evidence; absent on an ordinary creation request. Binds A.run_id, A workdir, draft content digest and evidence digest/uri so B's input fingerprint covers the source. A is never modified; B re-authors under its own final identity and re-validates.",
      "type": "object", "additionalProperties": false,
      "required": ["source_run_id", "source_run_uri", "source_draft_digest", "source_evidence_digest", "source_evidence_uri"],
      "properties": {
        "source_run_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
        "source_run_uri": {"type": "string", "minLength": 1, "maxLength": 512},
        "source_draft_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
        "source_evidence_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
        "source_evidence_uri": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "value", "source_ref"],
        "properties": {
          "path": {"type": "string", "pattern": "^/", "maxLength": 256},
          "value": {
            "oneOf": [
              {"type": "string", "maxLength": 1000},
              {"type": "number"},
              {"type": "boolean"},
              {"type": "array", "maxItems": 50, "items": {"type": ["string", "number", "boolean"]}}
            ]
          },
          "source_ref": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    },
    "requested_at": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"}
  }
}