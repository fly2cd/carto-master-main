{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/image-display-result.schema.json",
  "title": "image-display-result",
  "description": "Typed output of the image-display-bounds capability: the deterministic display window and the source size of the registered basemap image.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "display_window",
    "source_size"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "display_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {
          "type": "integer",
          "minimum": 0
        },
        "y": {
          "type": "integer",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px"],
      "properties": {
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
