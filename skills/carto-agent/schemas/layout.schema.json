{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/layout.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "layout_id",
    "version",
    "category",
    "canvas",
    "frames",
    "placeholders",
    "capacity",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"
    },
    "layout_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
    },
    "category": {
      "description": "DEPRECATED (map-layout.md §5.4): presentational tag, not a design decision; retained for v1 consumers.",
      "enum": [
        "general",
        "report",
        "poster",
        "atlas",
        "web",
        "mobile"
      ]
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "unit",
        "orientation",
        "safe_margin"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "mm",
            "px"
          ]
        },
        "orientation": {
          "enum": [
            "landscape",
            "portrait"
          ]
        },
        "safe_margin": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "content_id",
          "type",
          "coordinate_space",
          "bounds",
          "overflow_policy"
        ],
        "properties": {
          "id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "content_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier",
            "description": "Explicit binding to one view or overlay id."
          },
          "inside_frame": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier",
            "description": "Declared intentional containment: this frame sits entirely inside the referenced map frame (e.g. a north arrow placed within the map). The resolver verifies the reference, the frame types and full geometric enclosure; undeclared or partial overlap stays rejected."
          },
          "type": {
            "enum": [
              "map",
              "title",
              "legend",
              "scale-bar",
              "north-arrow",
              "inset",
              "marginalia",
              "chart"
            ]
          },
          "coordinate_space": {
            "const": "page"
          },
          "bounds": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/pageBox"
          },
          "overflow_policy": {
            "enum": [
              "clip",
              "shrink",
              "paginate",
              "reject"
            ]
          },
          "legend_columns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "view_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
            }
          },
          "view": {
            "description": "Inset-only: independent geographic view extent [minx,miny,maxx,maxy] in the declared CRS. An inset is a real secondary map view, never a pasted image.",
            "type": "object",
            "additionalProperties": false,
            "required": ["extent"],
            "properties": {
              "extent": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
            }
          },
          "main_map_ref": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier",
            "description": "Inset-only: the main map view this locator associates with."
          },
          "highlight_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier",
            "description": "Inset-only: optional object id highlighted in the locator view."
          },
          "content_role": {
            "description": "Page content semantic role (design §6.6), the single authority for main-map/inset-map/legend-group counting. Distinct from Style symbol_roles (thematic symbol semantics). Optional: contracts without it yield unknown role counts, never an auto-assumed main-map.",
            "enum": ["main-map", "inset-map", "legend-group", "title", "text", "chart", "decoration"]
          }
        }
      }
    },
    "placeholders": {
      "description": "DEPRECATED (map-layout.md §5.4): superseded by content_slots; retained for v1 consumers.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^\\{\\{[A-Z][A-Z0-9_]+\\}\\}$"
      }
    },
    "capacity": {
      "description": "DEPRECATED as hand-written limit (map-layout.md §5.4): target derives capacity from geometry/typography; retained required for v1 render capacity checks.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legend_items",
        "title_characters"
      ],
      "properties": {
        "legend_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "title_characters": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/rule"
      }
    },
    "content_padding_mm": {
      "type": "number",
      "minimum": 0.5,
      "maximum": 8
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        {"required": ["allowed_cases"]},
        {"required": ["allowed_shapes", "legend_modes"]}
      ],
      "required": [
        "panel_area",
        "shared_panel_area",
        "shared_legend_bounds",
        "source_bounds",
        "column_gap_mm",
        "row_gap_mm",
        "caption_height_mm",
        "caption_gap_mm",
        "legend_width_mm",
        "legend_gap_mm",
        "shared_legend_columns"
      ],
      "properties": {
        "allowed_shapes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              [
                1,
                1
              ],
              [
                1,
                2
              ],
              [
                2,
                2
              ]
            ]
          }
        },
        "legend_modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "independent",
              "shared"
            ]
          }
        },
        "panel_area": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/pageBox"
        },
        "shared_panel_area": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/pageBox"
        },
        "shared_legend_bounds": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/pageBox"
        },
        "source_bounds": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/pageBox"
        },
        "column_gap_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "row_gap_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "caption_height_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "caption_gap_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "legend_width_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "legend_gap_mm": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "shared_legend_columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "allowed_cases": {
          "description": "Reviewed finite parameter domain (plan phase 3, design §6.7). When present this is the SINGLE authority for admitted combinations, superseding allowed_shapes x legend_modes (no duplicate authority). Each case is a full tuple; legend_placement defaults to outside. A combination without an implemented consumer stays not-implemented.",
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rows", "columns", "legend_mode"],
            "properties": {
              "rows": {"type": "integer", "minimum": 1, "maximum": 2},
              "columns": {"type": "integer", "minimum": 1, "maximum": 2},
              "legend_mode": {"enum": ["independent", "shared"]},
              "legend_placement": {"enum": ["outside", "inside"]}
            }
          }
        },
        "inside_legend": {
          "description": "Author-declared inside-legend geometry (plan phase 3 §6.2). The grid mechanically derives each independent legend's bounds from this anchor/offset/size/padding relative to its own main-map frame and verifies full enclosure. Required when legend_placement=inside; never a free solver.",
          "type": "object",
          "additionalProperties": false,
          "required": ["anchor", "offset_mm", "width_mm", "height_mm", "padding_mm"],
          "properties": {
            "anchor": {"enum": ["top-left", "top-right", "bottom-left", "bottom-right"]},
            "offset_mm": {"type": "number", "minimum": 0, "maximum": 1000},
            "width_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
            "height_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 1000},
            "padding_mm": {"type": "number", "minimum": 0, "maximum": 1000}
          }
        }
      }
    },
    "content_slots": {
      "description": "Target (map-layout.md §5.4/§6.3): typed content interfaces (role, accepted types, count, requiredness). Optional until the slot migration lands; does not carry business text or data paths.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot_id", "accepts_types"],
        "properties": {
          "slot_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
          "accepts_types": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": {"enum": ["map", "legend", "title", "text", "image", "chart", "scale-bar", "north-arrow"]}
          },
          "required": {"type": "boolean"},
          "max_count": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
