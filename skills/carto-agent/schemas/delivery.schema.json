{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/delivery.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "targets", "rules"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "targets": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "medium", "format", "color_mode"], "properties": {
      "id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
      "medium": {"enum": ["print", "report", "atlas", "web", "mobile"]},
      "format": {"enum": ["pdf", "png"]},
      "page": {"type": "object", "additionalProperties": false, "required": ["width_mm", "height_mm", "dpi", "safe_margin_mm"], "properties": {"width_mm": {"type": "number", "exclusiveMinimum": 0}, "height_mm": {"type": "number", "exclusiveMinimum": 0}, "dpi": {"type": "integer", "minimum": 72, "maximum": 1200}, "safe_margin_mm": {"type": "number", "minimum": 0}, "bleed_mm": {"type": "number", "minimum": 0}}},
      "color_mode": {"enum": ["rgb", "cmyk-approved"]},
      "font_policy": {"enum": ["embed-approved", "outline-approved", "system-resolved"]}
    }}},
    "rules": {"type": "array", "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/rule"}}
  }
}
