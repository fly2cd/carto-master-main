{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/template-brief.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "brief_id", "kind", "namespace", "template_id", "version", "scope", "purpose", "audience", "reuse_intent", "supported_uses", "excluded_uses", "sources", "source_license_summary", "authoring_mode", "targets", "data_roles", "spatial_applicability", "evidence_records", "decisions", "open_questions", "revision"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "brief_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "kind": {"const": "map-scenario"},
    "namespace": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "template_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"},
    "scope": {"type": "string", "pattern": "^project:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 128},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 1000},
    "audience": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
    "reuse_intent": {"type": "string", "minLength": 1, "maxLength": 500},
    "supported_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}},
    "excluded_uses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"}},
    "source_license_summary": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["source_id", "license", "data_nature"], "properties": {"source_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}, "license": {"enum": ["public", "project-approved"]}, "data_nature": {"const": "synthetic"}}}},
    "authoring_mode": {"enum": ["standard", "fidelity", "mirror"]},
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["svg", "pdf", "png"]}},
    "data_roles": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["role_id", "source_id", "geometry_types", "value_field", "semantic_role"], "properties": {"role_id": {"enum": ["risk-area", "shelter-point"]}, "source_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}, "geometry_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["point", "polygon", "multipolygon"]}}, "value_field": {"enum": ["risk_pct", "capacity"]}, "semantic_role": {"enum": ["risk-value", "count-value"]}}}},
    "spatial_applicability": {"type": "object", "additionalProperties": false, "required": ["source_crs", "display_crs", "extent_policy"], "properties": {"source_crs": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/crs"}, "display_crs": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/crs"}, "extent_policy": {"const": "data"}}},
    "evidence_records": {"type": "array", "minItems": 4, "items": {"$ref": "https://schemas.carto-agent.local/v1/template-analysis.schema.json#/$defs/evidenceRecord"}},
    "decisions": {"type": "array", "items": {"$ref": "https://schemas.carto-agent.local/v1/template-analysis.schema.json#/$defs/evidenceRecord"}},
    "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 500}},
    "revision": {"type": "integer", "minimum": 1}
  }
}