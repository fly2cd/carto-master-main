{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/render-scene.schema.json",
  "oneOf": [
    {
      "title": "RenderScene deterministic rendering contract",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scene_id",
        "revision",
        "renderer_id",
        "spatial_context",
        "renderer_requirements",
        "viewport",
        "camera",
        "map",
        "overlays",
        "resources",
        "export",
        "random_seed",
        "provenance"
      ],
      "properties": {
        "resolved_layout": {
          "$ref": "https://schemas.carto-agent.local/v2/resolved-layout.schema.json"
        },
        "schema_version": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"
        },
        "scene_id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "renderer_id": {
          "const": "maplibre-web"
        },
        "spatial_context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "display_crs",
            "axis_order",
            "coordinate_units"
          ],
          "properties": {
            "display_crs": {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/crs"
            },
            "axis_order": {
              "enum": [
                "longitude-latitude",
                "easting-northing"
              ]
            },
            "coordinate_units": {
              "enum": [
                "degrees",
                "meters"
              ]
            }
          }
        },
        "renderer_requirements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "renderer_id",
            "require_webgl",
            "require_offline_rendering",
            "required_capabilities",
            "required_fonts",
            "minimum_device_pixel_ratio"
          ],
          "properties": {
            "renderer_id": {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
            },
            "require_webgl": {
              "type": "boolean"
            },
            "require_offline_rendering": {
              "type": "boolean"
            },
            "required_capabilities": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "enum": [
                  "svg-overlay",
                  "geographic-anchor",
                  "feature-anchor",
                  "headless-export"
                ]
              }
            },
            "required_fonts": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "minimum_device_pixel_ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 4
            }
          }
        },
        "viewport": {
          "$ref": "#/$defs/viewport"
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bounds",
            "bearing",
            "pitch"
          ],
          "properties": {
            "bounds": {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/bbox"
            },
            "bearing": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            "pitch": {
              "type": "number",
              "minimum": 0,
              "maximum": 90
            },
            "padding": {
              "$ref": "#/$defs/padding"
            }
          }
        },
        "map": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "style_ref",
            "sources",
            "layers"
          ],
          "properties": {
            "style_ref": {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
            },
            "sources": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/source"
              }
            },
            "layers": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/layer"
              }
            }
          }
        },
        "overlays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overlay"
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "export": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targets",
            "dpi"
          ],
          "properties": {
            "targets": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "svg",
                  "pdf",
                  "png"
                ]
              }
            },
            "dpi": {
              "type": "integer",
              "minimum": 72,
              "maximum": 1200
            }
          }
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/provenance"
          }
        },
        "random_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scene_id",
        "revision",
        "viewport",
        "resolved_layout",
        "export",
        "random_seed",
        "renderer_id",
        "context",
        "prepared_bundle_ref",
        "page_request_ref",
        "resources"
      ],
      "properties": {
        "schema_version": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"
        },
        "scene_id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width_px",
            "height_px",
            "device_pixel_ratio"
          ],
          "properties": {
            "width_px": {
              "type": "integer",
              "minimum": 1
            },
            "height_px": {
              "type": "integer",
              "minimum": 1
            },
            "device_pixel_ratio": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 4
            }
          }
        },
        "resolved_layout": {
          "$ref": "https://schemas.carto-agent.local/v2/resolved-layout.schema.json"
        },
        "export": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targets",
            "dpi"
          ],
          "properties": {
            "targets": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "svg",
                  "pdf",
                  "png"
                ]
              }
            },
            "dpi": {
              "type": "integer",
              "minimum": 72,
              "maximum": 1200
            }
          }
        },
        "random_seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "renderer_id": {
          "enum": [
            "rasterio-matplotlib-page",
            "matplotlib-vector-page",
            "image-itinerary-page"
          ]
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run_id",
            "tenant_id",
            "project_id",
            "subject_id"
          ],
          "properties": {
            "run_id": {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
            },
            "tenant_id": {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
            },
            "project_id": {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
            },
            "subject_id": {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
            }
          }
        },
        "prepared_bundle_ref": {
          "allOf": [
            {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
            },
            {
              "required": [
                "uri"
              ],
              "properties": {
                "id": {
                  "const": "prepared-data-bundle"
                },
                "version": {
                  "const": "1.0.0"
                }
              }
            }
          ]
        },
        "page_request_ref": {
          "allOf": [
            {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
            },
            {
              "required": [
                "uri"
              ],
              "properties": {
                "id": {
                  "const": "page-request"
                },
                "version": {
                  "const": "5.0.0"
                }
              }
            }
          ]
        },
        "resources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "digest_mode",
              "ref"
            ],
            "properties": {
              "id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "kind": {
                "enum": [
                  "data",
                  "font",
                  "contract"
                ]
              },
              "digest_mode": {
                "enum": [
                  "bytes",
                  "canonical-json"
                ]
              },
              "ref": {
                "allOf": [
                  {
                    "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
                  },
                  {
                    "required": [
                      "uri"
                    ]
                  }
                ]
              }
            }
          }
        },
        "image_graphics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id",
              "frame_id",
              "coordinate_space"
            ],
            "properties": {
              "type": {
                "enum": [
                  "line",
                  "point",
                  "callout",
                  "label",
                  "arrow"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "frame_id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "coordinate_space": {
                "const": "image-pixel"
              },
              "points": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                }
              },
              "position": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "x",
                  "y"
                ],
                "properties": {
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  }
                }
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "visit_order": {
                "type": "integer",
                "minimum": 1
              },
              "stop_orders": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "shape": {
                "enum": [
                  "pin",
                  "circle"
                ]
              },
              "show_number": {
                "type": "boolean"
              },
              "title": {
                "type": "string",
                "maxLength": 200
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "content": {
                "type": "string",
                "maxLength": 200
              },
              "title_color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "body_color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "width_px": {
                "type": "number",
                "minimum": 0
              },
              "height_px": {
                "type": "number",
                "minimum": 0
              },
              "halo_width_px": {
                "type": "number",
                "minimum": 0
              },
              "radius_px": {
                "type": "number",
                "minimum": 0
              },
              "font_size_px": {
                "type": "number",
                "minimum": 0
              },
              "title_font_px": {
                "type": "number",
                "minimum": 0
              },
              "body_font_px": {
                "type": "number",
                "minimum": 0
              },
              "padding_px": {
                "type": "number",
                "minimum": 0
              },
              "line_gap_px": {
                "type": "number",
                "minimum": 0
              },
              "offset_x_px": {
                "type": "number"
              },
              "offset_y_px": {
                "type": "number"
              },
              "right_offset_px": {
                "type": "number"
              },
              "font_weight": {
                "type": "integer",
                "minimum": 100,
                "maximum": 900
              },
              "title_wrap": {
                "type": "boolean"
              },
              "opacity": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "leader_width_px": {
                "type": "number",
                "minimum": 0
              },
              "arrows": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "size_px",
                  "spacing_px"
                ],
                "properties": {
                  "size_px": {
                    "type": "number",
                    "minimum": 1
                  },
                  "spacing_px": {
                    "type": "number",
                    "minimum": 10
                  }
                }
              },
              "route_mode": {
                "enum": [
                  "road_network",
                  "provided_geometry",
                  "schematic",
                  "straight_line"
                ],
                "description": "Line graphics: the frozen route mode of the route part."
              },
              "group": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier",
                "description": "Point/callout graphics: the itinerary group id the color came from."
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "renderer_id": {
                "const": "rasterio-matplotlib-page"
              }
            }
          },
          "then": {
            "properties": {
              "page_request_ref": {
                "properties": {
                  "id": {
                    "const": "page-request"
                  },
                  "version": {
                    "const": "5.0.0"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "renderer_id": {
                "const": "matplotlib-vector-page"
              }
            }
          },
          "then": {
            "properties": {
              "page_request_ref": {
                "properties": {
                  "id": {
                    "const": "page-request"
                  },
                  "version": {
                    "const": "5.0.0"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "renderer_id": {
                "const": "image-itinerary-page"
              }
            }
          },
          "then": {
            "required": [
              "image_graphics"
            ],
            "properties": {
              "image_graphics": {},
              "page_request_ref": {
                "properties": {
                  "id": {
                    "const": "page-request"
                  },
                  "version": {
                    "const": "5.0.0"
                  }
                }
              }
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_px",
        "height_px",
        "device_pixel_ratio",
        "background"
      ],
      "properties": {
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        },
        "device_pixel_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4
        },
        "background": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        }
      }
    },
    "padding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "properties": {
        "top": {
          "type": "number",
          "minimum": 0
        },
        "right": {
          "type": "number",
          "minimum": 0
        },
        "bottom": {
          "type": "number",
          "minimum": 0
        },
        "left": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "resource_id"
      ],
      "properties": {
        "id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "type": {
          "enum": [
            "vector",
            "raster",
            "geojson",
            "image"
          ]
        },
        "resource_id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "type",
        "z_index"
      ],
      "properties": {
        "id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "source_id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "source_layer": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "fill",
            "line",
            "circle",
            "symbol",
            "raster",
            "heatmap",
            "fill-extrusion",
            "hillshade"
          ]
        },
        "paint": {
          "$ref": "#/$defs/propertyBag"
        },
        "layout": {
          "$ref": "#/$defs/propertyBag"
        },
        "filter": {
          "$ref": "#/$defs/jsonValue"
        },
        "minzoom": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "maxzoom": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        },
        "z_index": {
          "type": "integer"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "ref",
        "required"
      ],
      "properties": {
        "id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "kind": {
          "enum": [
            "geojson",
            "vector-tiles",
            "raster-tiles",
            "image",
            "map-style",
            "font",
            "icon",
            "sprite",
            "glyph",
            "symbol"
          ]
        },
        "ref": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
        },
        "required": {
          "type": "boolean"
        },
        "font_family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "font"
              }
            }
          },
          "then": {
            "required": [
              "font_family"
            ]
          }
        }
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "unit"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "unit": {
          "enum": [
            "normalized",
            "pixel"
          ]
        },
        "anchor": {
          "enum": [
            "top-left",
            "top-center",
            "top-right",
            "center-left",
            "center",
            "center-right",
            "bottom-left",
            "bottom-center",
            "bottom-right"
          ]
        },
        "offset_mm": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "longitude",
        "latitude"
      ],
      "properties": {
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "coordinate_space"
      ],
      "properties": {
        "id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "type": {
          "enum": [
            "text",
            "symbol",
            "legend",
            "north-arrow",
            "scale-bar",
            "attribution",
            "complex-symbol"
          ]
        },
        "coordinate_space": {
          "enum": [
            "page",
            "viewport",
            "geographic",
            "feature"
          ]
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "screen_position": {
          "$ref": "#/$defs/position"
        },
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "content": {
          "type": "string"
        },
        "style_role": {
          "type": "string",
          "minLength": 1
        },
        "symbol_ref": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "label": {
          "type": "string"
        },
        "source_id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "feature_id": {
          "type": "string",
          "minLength": 1
        },
        "anchor_rule": {
          "type": "string",
          "minLength": 1
        },
        "legend_items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/legendItem"
          }
        },
        "length_px": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "distance_label": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coordinate_space": {
                "enum": [
                  "page",
                  "viewport"
                ]
              }
            }
          },
          "then": {
            "required": [
              "position"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "coordinate_space": {
                "const": "geographic"
              }
            }
          },
          "then": {
            "required": [
              "anchor"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "coordinate_space": {
                "const": "feature"
              }
            }
          },
          "then": {
            "required": [
              "source_id",
              "feature_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "text",
                  "attribution"
                ]
              }
            }
          },
          "then": {
            "required": [
              "content"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "symbol",
                  "complex-symbol"
                ]
              }
            }
          },
          "then": {
            "required": [
              "symbol_ref"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "legend"
              }
            }
          },
          "then": {
            "required": [
              "legend_items"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "scale-bar"
              }
            }
          },
          "then": {
            "required": [
              "length_px",
              "distance_label"
            ]
          }
        }
      ]
    },
    "legendItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "color"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9A-F]{6}$"
        },
        "symbol": {
          "enum": [
            "fill",
            "line",
            "circle"
          ]
        }
      }
    },
    "propertyBag": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/jsonValue"
      }
    },
    "jsonValue": {
      "oneOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jsonValue"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/jsonValue"
          }
        }
      ]
    }
  }
}