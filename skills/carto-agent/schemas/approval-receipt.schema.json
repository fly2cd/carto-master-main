{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/approval-receipt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_id", "issuer", "subject_id",
    "tenant_id", "action", "object_type", "object_digest",
    "scope", "policy_id", "environment", "nonce",
    "issued_at", "expires_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "receipt_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "issuer": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "object_type": {"type": "string", "minLength": 1},
    "object_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "scope": {"type": "string", "minLength": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "environment": {"type": "string", "minLength": 1},
    "nonce": {"type": "string", "minLength": 16, "maxLength": 128},
    "issued_at": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"},
    "expires_at": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"},
    "signature_algorithm": {"const": "hmac-sha256"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}