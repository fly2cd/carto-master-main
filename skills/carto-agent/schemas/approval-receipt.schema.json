{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.carto-agent.local/v1/approval-receipt.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["receipt_id", "action", "object_digest", "issued_at", "expires_at"],
  "properties": {
    "receipt_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "action": {"type": "string", "minLength": 1},
    "object_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "issued_at": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"},
    "expires_at": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"},
    "signature_algorithm": {"const": "hmac-sha256"},
    "signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}