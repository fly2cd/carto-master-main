{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/segment-analysis.schema.json",
  "description": "Design analysis for an independent segment template. Unlike template-analysis (scenario), it has no data-source summaries or source-manifest digest: segments carry a confirmed design, not business data. Evidence records reuse the shared evidenceRecord definition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "analysis_id",
    "request_digest",
    "design_digest",
    "kind",
    "evidence_records",
    "open_questions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "analysis_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "request_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "design_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "kind": {"enum": ["map-style", "map-layout"]},
    "evidence_records": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "https://schemas.carto-agent.local/v1/template-analysis.schema.json#/$defs/evidenceRecord"}
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  }
}