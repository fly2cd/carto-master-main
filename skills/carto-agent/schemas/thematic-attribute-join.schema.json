{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/thematic-attribute-join.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_id",
    "path",
    "digest",
    "size_bytes",
    "geometry_key",
    "table_key",
    "fields",
    "coverage",
    "missing_policy"
  ],
  "properties": {
    "source_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "geometry_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "table_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "coverage": {
      "const": "exact"
    },
    "missing_policy": {
      "enum": [
        "reject",
        "null"
      ]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "column",
          "field",
          "value_type"
        ],
        "properties": {
          "column": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "value_type": {
            "enum": [
              "number",
              "string"
            ]
          }
        }
      }
    }
  }
}
