{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/geospatial-mcp-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "server_id",
    "server_version",
    "server_python",
    "tenant_id",
    "project_id",
    "data_root",
    "catalog_path",
    "allowed_dataset_ids",
    "limits"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "server_id": {
      "const": "geospatial-mcp"
    },
    "server_version": {
      "const": "0.3.0"
    },
    "server_python": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "tenant_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "project_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "data_root": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "catalog_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "allowed_dataset_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      },
      "uniqueItems": true
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_input_bytes",
        "max_artifact_bytes",
        "max_raster_pixels",
        "max_raster_classes",
        "max_response_bytes",
        "timeout_seconds"
      ],
      "properties": {
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "max_artifact_bytes": {
          "type": "integer",
          "minimum": 8,
          "maximum": 16777216
        },
        "max_raster_pixels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16000000
        },
        "max_raster_classes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 2097152
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 300
        }
      }
    }
  }
}
