{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/cartography.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "style_id", "version", "visual_language", "symbolization", "labeling", "generalization", "defaults", "rules"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "style_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"},
    "visual_language": {"enum": ["editorial", "technical", "minimal", "statistical", "narrative"]},
    "symbolization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color_system", "symbol_catalogs"],
      "properties": {
        "color_system": {"enum": ["sequential", "diverging", "qualitative", "mixed"]},
        "symbol_catalogs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"}},
        "default_opacity": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "labeling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["density", "collision_policy", "font_role"],
      "properties": {
        "density": {"enum": ["low", "medium", "high"]},
        "collision_policy": {"enum": ["avoid", "prioritize", "allow-explicit"]},
        "font_role": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}
      }
    },
    "generalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale_dependent", "strategy"],
      "properties": {
        "scale_dependent": {"type": "boolean"},
        "strategy": {"enum": ["simplify", "aggregate", "select", "none"]}
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line_width_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 10},
        "point_size_mm": {"type": "number", "exclusiveMinimum": 0, "maximum": 50},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "rules": {"type": "array", "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/rule"}}
  }
}
