{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/quality-gates.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "baseline", "checks"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "baseline": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "params"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$", "maxLength": 160},
          "version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"},
          "params": {
            "type": "object",
            "maxProperties": 32,
            "additionalProperties": {
              "oneOf": [
                {"type": "string", "maxLength": 500},
                {"type": "number"},
                {"type": "boolean"},
                {"type": "array", "maxItems": 100, "items": {"type": ["string", "number", "boolean"]}}
              ]
            }
          }
        }
      }
    }
  }
}
