{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/revision-dependency-graph.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "run_id",
    "proposal_id",
    "invalidated_nodes",
    "data_evidence_reusable",
    "bundle_input_digest",
    "earliest_step",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 2
    },
    "run_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "proposal_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "invalidated_nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": ["plan", "candidate", "scene", "preflight", "preview", "data-evidence"]
      }
    },
    "data_evidence_reusable": {
      "type": "boolean"
    },
    "evidence_digest": {
      "description": "Canonical digest of the actual prepared data evidence document (e.g. the assembled itinerary). Present only for revisions that carry/inherit a data-evidence binding: the runtime gate re-verifies the live evidence file against this digest at compile, so 'not reusable' claims and reuse decisions are both independently checked — never trusted from the static rules alone.",
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
    },
    "evidence_ref": {
      "description": "Reference to the revision-staged evidence snapshot (frozen copy of the data facts the revision was approved against).",
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "bundle_input_digest": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
    },
    "reusable_bundle_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "earliest_step": {
      "enum": ["compile"]
    },
    "created_at": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"
    }
  }
}
