{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/scenario.schema.json",
  "description": "MapScenario composition contract. Each of cartography/layout must be sourced exactly once: either embedded inline or referenced via segment_refs to a published segment template (cartography->map-style, layout->map-layout). Referenced segments must be listed in replaceable_segments, pinned in manifest.dependencies and dependency-lock.dependencies with identical {kind,id,version,digest}, and their ownership transfers to the segment kind. Mutual exclusion, replaceability and lock consistency are semantic rules enforced by OwnershipResolver; validate/publish and generate resolve referenced segments from the published repository at the admission/load boundary (S2). The identity/map-brand segment was removed (2026-11-18, user-authorized): it had no rendering consumer.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "version",
    "business_scene",
    "tasks",
    "owned_segments",
    "embedded",
    "replaceable_segments",
    "data_role_refs",
    "target_ids",
    "application",
    "compatibility",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"
    },
    "scenario_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
    },
    "business_scene": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/businessSceneId"
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
      }
    },
    "owned_segments": {
      "type": "array",
      "prefixItems": [
        {
          "const": "scenario"
        },
        {
          "const": "data"
        },
        {
          "const": "spatial-behavior"
        },
        {
          "const": "portrayal"
        },
        {
          "const": "delivery"
        },
        {
          "const": "quality-gates"
        }
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6
    },
    "embedded": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {
          "$ref": "https://schemas.carto-agent.local/v2/style.schema.json"
        },
        "layout": {
          "$ref": "https://schemas.carto-agent.local/v1/layout.schema.json"
        }
      }
    },
    "segment_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "style": {
          "allOf": [
            {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/templateRef"},
            {"properties": {"kind": {"const": "map-style"}}}
          ]
        },
        "layout": {
          "allOf": [
            {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/templateRef"},
            {"properties": {"kind": {"const": "map-layout"}}}
          ]
        }
      }
    },
    "replaceable_segments": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "style",
          "layout"
        ]
      }
    },
    "data_role_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
      }
    },
    "target_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supported_uses",
        "excluded_uses"
      ],
      "properties": {
        "supported_uses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          }
        },
        "excluded_uses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_profiles",
        "placeholders"
      ],
      "properties": {
        "target_profiles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          }
        },
        "placeholders": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\{\\{[A-Z][A-Z0-9_]+\\}\\}$"
          }
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/rule"
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        {"properties": {"embedded": {"required": ["style"]}}, "required": ["embedded"]},
        {"properties": {"segment_refs": {"required": ["style"]}}, "required": ["segment_refs"]}
      ]
    },
    {
      "anyOf": [
        {"properties": {"embedded": {"required": ["layout"]}}, "required": ["embedded"]},
        {"properties": {"segment_refs": {"required": ["layout"]}}, "required": ["segment_refs"]}
      ]
    }
  ]
}
