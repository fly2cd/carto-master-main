{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/capability-roadmap.schema.json",
  "title": "capability-roadmap",
  "description": "Declared not-implemented capability queue. A guard may only raise CAPABILITY-class 'not_implemented' for features listed here; undeclared or delivered features are configuration errors.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "items"],
  "properties": {
    "schema_version": {"const": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "note"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
          "status": {"enum": ["planned", "backlog", "delivered"]},
          "target": {"type": "string"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
