{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/source-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "sources"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "manifest_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_id", "kind", "location_ref", "digest", "provenance", "license", "captured_at"],
        "properties": {
          "source_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
          "kind": {"enum": ["geopackage", "geojson", "csv", "qgis-project", "svg", "pdf", "png", "document", "api-snapshot"]},
          "location_ref": {"type": "string", "minLength": 1, "maxLength": 1024},
          "digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
          "provenance": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/provenance"},
          "license": {"enum": ["public", "project-approved", "restricted"]},
          "captured_at": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"},
          "data_profile": {
            "type": "object", "additionalProperties": false,
            "required": ["data_nature", "contains_production_data", "contains_sensitive_coordinates", "source_crs"],
            "properties": {
              "data_nature": {"const": "synthetic"},
              "contains_production_data": {"const": false},
              "contains_sensitive_coordinates": {"const": false},
              "source_crs": {"allOf": [{"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/crs"}, {"properties": {"authority": {"const": "EPSG"}, "code": {"const": "4326"}}}]}
            }
          }
        }
      }
    }
  }
}