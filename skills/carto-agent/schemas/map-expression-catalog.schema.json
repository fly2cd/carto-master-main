{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/map-expression-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_id",
    "version",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "catalog_id": {
      "const": "carto-map-expressions"
    },
    "version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/map-expression.schema.json"
      }
    }
  }
}
