{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/map-expression.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "expression_id",
    "version",
    "title",
    "status",
    "field_requirements",
    "parameter_definitions",
    "visual_variables",
    "legend",
    "missing_value_policy",
    "outlier_policy",
    "checker_refs"
  ],
  "oneOf": [
    {"required": ["geometry_types"]},
    {"required": ["applicable_geometry"]}
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"
    },
    "expression_id": {
      "anyOf": [
        {"type": "string", "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$", "maxLength": 120},
        {"type": "string", "enum": ["categorical", "graduated-color", "proportional-symbol"], "maxLength": 120}
      ]
    },
    "version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "enum": [
        "active",
        "deprecated"
      ]
    },
    "geometry_types": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "point",
          "polygon",
          "linestring",
          "multilinestring",
          "raster",
          "vector"
        ]
      }
    },
    "applicable_geometry": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "line",
          "point",
          "polygon",
          "raster",
          "vector"
        ]
      }
    },
    "superseded_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "adapters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "patternProperties": {
        "^(raster|vector|point|polygon)$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm_id", "fixture_kind"],
          "properties": {
            "algorithm_id": {
              "type": "string",
              "minLength": 1
            },
            "fixture_kind": {
              "type": "string",
              "minLength": 1
            },
            "max_bytes": {"type": "integer", "minimum": 1},
            "encoding": {"type": "string"},
            "columns": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "type"],
                "properties": {
                  "name": {"type": "string", "minLength": 1},
                  "type": {"enum": ["integer", "number", "string"]},
                  "min": {"type": "number"},
                  "max": {"type": "number"},
                  "min_length": {"type": "integer", "minimum": 0},
                  "max_length": {"type": "integer", "minimum": 0},
                  "unique": {"type": "boolean"}
                }
              }
            }
          }
        }
      }
    },
    "field_requirements": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "semantic_role",
          "value_type",
          "required",
          "nullable"
        ],
        "properties": {
          "semantic_role": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "value_type": {
            "enum": [
              "integer",
              "number",
              "string"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "nullable": {
            "type": "boolean"
          },
          "minimum": {
            "type": "number"
          },
          "maximum": {
            "type": "number"
          }
        }
      }
    },
    "parameter_definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "required"
        ],
        "properties": {
          "name": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "type": {
            "enum": [
              "integer",
              "number",
              "boolean",
              "string",
              "enum"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "default": {
            "type": [
              "integer",
              "number",
              "boolean",
              "string"
            ]
          }
        }
      }
    },
    "visual_variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variable",
          "source_role",
          "algorithm_id"
        ],
        "properties": {
          "variable": {
            "enum": [
              "fill-color",
              "symbol-area"
            ]
          },
          "source_role": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "algorithm_id": {
            "enum": [
              "sequential-classification",
              "area-proportional-scaling",
              "categorical-lookup",
              "explicit-vector-encoding"
            ]
          }
        }
      }
    },
    "legend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "show_no_data",
        "label_source"
      ],
      "properties": {
        "type": {
          "enum": [
            "classed-color",
            "graduated-size",
            "categorical-color"
          ]
        },
        "show_no_data": {
          "type": "boolean"
        },
        "label_source": {
          "enum": [
            "class-breaks",
            "representative-values",
            "category-labels"
          ]
        }
      }
    },
    "missing_value_policy": {
      "enum": [
        "explicit-symbol",
        "omit-with-note",
        "reject"
      ]
    },
    "outlier_policy": {
      "enum": [
        "clip-to-domain",
        "extend-domain",
        "reject"
      ]
    },
    "checker_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/checkerRef"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rules": {
          "type": "array",
          "minItems": 0,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "param": {
                "type": "string",
                "minLength": 1
              },
              "param_a": {
                "type": "string",
                "minLength": 1
              },
              "param_b": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "enum": ["less_than_or_equal"]
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "allowed": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true
              },
              "value": {},
              "description": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "encoding": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "type"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "enum": ["integer", "number", "string"]
              },
              "min": {
                "type": "number"
              },
              "max": {
                "type": "number"
              },
              "min_length": {
                "type": "integer",
                "minimum": 0
              },
              "max_length": {
                "type": "integer",
                "minimum": 0
              },
              "unique": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "fixture_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["geometry_types"],
        "anyOf": [
          {
            "properties": {
              "geometry_types": {
                "contains": {
                  "const": "raster"
                }
              }
            }
          },
          {
            "properties": {
              "expression_id": {
                "const": "raster/categorical"
              }
            }
          },
          {
            "properties": {
              "visual_variables": {
                "contains": {
                  "properties": {
                    "algorithm_id": {
                      "const": "categorical-lookup"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "expression_id": {
            "const": "raster/categorical"
          },
          "geometry_types": {
            "const": [
              "raster"
            ]
          },
          "field_requirements": {
            "const": [
              {
                "semantic_role": "category-value",
                "value_type": "number",
                "required": true,
                "nullable": true
              }
            ]
          },
          "parameter_definitions": {
            "const": []
          },
          "visual_variables": {
            "const": [
              {
                "variable": "fill-color",
                "source_role": "category-value",
                "algorithm_id": "categorical-lookup"
              }
            ]
          },
          "legend": {
            "const": {
              "type": "categorical-color",
              "show_no_data": false,
              "label_source": "category-labels"
            }
          },
          "missing_value_policy": {
            "const": "reject"
          },
          "outlier_policy": {
            "const": "reject"
          }
        }
      }
    },
    {
      "if": {
        "required": ["geometry_types"],
        "anyOf": [
          {
            "required": [
              "expression_id"
            ],
            "properties": {
              "expression_id": {
                "const": "vector/explicit"
              }
            }
          },
          {
            "required": [
              "geometry_types"
            ],
            "properties": {
              "geometry_types": {
                "contains": {
                  "const": "vector"
                }
              }
            }
          },
          {
            "required": [
              "visual_variables"
            ],
            "properties": {
              "visual_variables": {
                "contains": {
                  "required": [
                    "algorithm_id"
                  ],
                  "properties": {
                    "algorithm_id": {
                      "const": "explicit-vector-encoding"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "expression_id": {
            "const": "vector/explicit"
          },
          "geometry_types": {
            "const": [
              "vector"
            ]
          },
          "field_requirements": {
            "const": []
          },
          "parameter_definitions": {
            "const": []
          },
          "visual_variables": {
            "const": [
              {
                "variable": "fill-color",
                "source_role": "thematic-value",
                "algorithm_id": "explicit-vector-encoding"
              }
            ]
          },
          "legend": {
            "const": {
              "type": "categorical-color",
              "show_no_data": true,
              "label_source": "category-labels"
            }
          },
          "missing_value_policy": {
            "const": "explicit-symbol"
          },
          "outlier_policy": {
            "const": "reject"
          }
        }
      }
    }
  ]
}
