{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/candidate-set.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "set_id",
    "run_id",
    "project_id",
    "candidates",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "set_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "project_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id",
          "candidate_id",
          "resolved_map_digest",
          "render_scene_digest",
          "preflight_status",
          "preflight_report_digest"
        ],
        "properties": {
          "variant_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "candidate_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "resolved_map_digest": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
          },
          "render_scene_digest": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
          },
          "preflight_status": {
            "enum": ["passed", "failed"]
          },
          "preflight_report_digest": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
          }
        }
      }
    },
    "created_at": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"
    }
  }
}
