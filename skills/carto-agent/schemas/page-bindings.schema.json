{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v2/page-bindings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "data_bindings",
    "layers",
    "views",
    "panels",
    "legends",
    "elements",
    "sharing"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "data_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "role",
          "dataset_ref",
          "prepared_ref",
          "source_id"
        ],
        "properties": {
          "id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "role": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "dataset_ref": {
            "allOf": [
              {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
              },
              {
                "required": [
                  "uri"
                ]
              }
            ]
          },
          "prepared_ref": {
            "allOf": [
              {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
              },
              {
                "required": [
                  "uri"
                ]
              }
            ]
          },
          "source_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          }
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "data_binding_id",
          "expression_ref"
        ],
        "properties": {
          "id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "data_binding_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "expression_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version",
              "digest"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$"
              },
              "version": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
              },
              "digest": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
              }
            }
          }
        }
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "layer_ids",
          "extent",
          "crs"
        ],
        "properties": {
          "id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "layer_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
            },
            "uniqueItems": true
          },
          "extent": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/bbox"
          },
          "crs": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/crs"
          }
        }
      }
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "view_id",
          "frame_id"
        ],
        "properties": {
          "id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "view_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "frame_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          }
        }
      }
    },
    "legends": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "frame_id",
          "view_ids",
          "layer_ids"
        ],
        "properties": {
          "id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "frame_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "view_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
            },
            "uniqueItems": true
          },
          "layer_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 0,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "frame_id",
          "kind",
          "view_id"
        ],
        "properties": {
          "id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "frame_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "kind": {
            "enum": [
              "title",
              "marginalia",
              "scale-bar",
              "north-arrow"
            ]
          },
          "view_id": {
            "anyOf": [
              {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "sharing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_groups",
        "encoding_groups",
        "legend_groups"
      ],
      "properties": {
        "view_groups": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "members"
            ],
            "properties": {
              "id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "members": {
                "type": "array",
                "minItems": 2,
                "maxItems": 32,
                "items": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "encoding_groups": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "members"
            ],
            "properties": {
              "id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "members": {
                "type": "array",
                "minItems": 2,
                "maxItems": 32,
                "items": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "legend_groups": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "members"
            ],
            "properties": {
              "id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "members": {
                "type": "array",
                "minItems": 2,
                "maxItems": 32,
                "items": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                },
                "uniqueItems": true
              }
            }
          }
        }
      }
    }
  }
}
