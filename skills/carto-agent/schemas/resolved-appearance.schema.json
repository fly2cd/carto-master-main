{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v2/resolved-appearance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "style",
    "style_ref",
    "typography",
    "color_sources"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "style": {
      "$ref": "https://schemas.carto-agent.local/v2/style.schema.json"
    },
    "style_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title_pt",
        "body_pt",
        "legend_pt",
        "legend_heading_pt",
        "padding_mm",
        "line_spacing"
      ],
      "properties": {
        "title_pt": {
          "type": "number",
          "minimum": 10,
          "maximum": 40
        },
        "body_pt": {
          "type": "number",
          "minimum": 8,
          "maximum": 18
        },
        "legend_pt": {
          "type": "number",
          "minimum": 8,
          "maximum": 18
        },
        "legend_heading_pt": {
          "type": "number",
          "minimum": 8,
          "maximum": 20
        },
        "padding_mm": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 8
        },
        "line_spacing": {
          "type": "number",
          "minimum": 1.1,
          "maximum": 2
        }
      }
    },
    "color_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "view_id",
          "ref"
        ],
        "properties": {
          "view_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "ref": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
          }
        }
      }
    }
  }
}
