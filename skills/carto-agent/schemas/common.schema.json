{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/common.schema.json",
  "title": "Carto Agent shared protocol definitions",
  "$defs": {
    "schemaVersion": {
      "const": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 80
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$))(?!.*[\\u0000-\\u001f]).+$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "uri": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "templateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "kind": {
          "enum": [
            "map-brand",
            "map-style",
            "map-layout",
            "map-scenario"
          ]
        },
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "mapExpressionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "digest"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*/[a-z][a-z0-9-]*$",
          "maxLength": 120
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "resourceRef": {
      "oneOf": [
        {
          "$ref": "#/$defs/artifactRef"
        },
        {
          "$ref": "#/$defs/mapExpressionRef"
        }
      ]
    },
    "checkerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$",
          "maxLength": 160
        },
        "version": {
          "$ref": "#/$defs/semanticVersion"
        }
      }
    },
    "pageBox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "number",
          "exclusiveMinimum": 0
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_type",
        "source_ref",
        "classification"
      ],
      "properties": {
        "source_type": {
          "enum": [
            "user",
            "official",
            "internal",
            "derived",
            "inferred"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "version": {
          "type": "string",
          "maxLength": 128
        },
        "retrieved_at": {
          "$ref": "#/$defs/timestamp"
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "strength",
        "path",
        "description"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "strength": {
          "enum": [
            "hard_rule",
            "forbidden",
            "mandatory",
            "binding",
            "default",
            "reference"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/",
          "maxLength": 256
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "value": {},
        "condition": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      }
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "crs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "code"
      ],
      "properties": {
        "authority": {
          "enum": [
            "EPSG",
            "CGCS2000",
            "CUSTOM"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "wkt_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "executionSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_ref",
        "business_scene",
        "map_tasks",
        "template_refs",
        "dataset_refs",
        "ownership",
        "shared_semantics",
        "views",
        "targets",
        "environment",
        "resolved_layout",
        "profile_refs"
      ],
      "properties": {
        "intent_ref": {
          "$ref": "#/$defs/artifactRef"
        },
        "profile_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          },
          "uniqueItems": true
        },
        "business_scene": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/businessSceneId"
        },
        "map_tasks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "template_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/templateRef"
          },
          "uniqueItems": true
        },
        "dependency_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceRef"
          },
          "uniqueItems": true
        },
        "policy_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          },
          "uniqueItems": true
        },
        "dataset_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/artifactRef"
          },
          "uniqueItems": true
        },
        "prepared_data_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          },
          "uniqueItems": true
        },
        "knowledge_evidence_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          },
          "uniqueItems": true
        },
        "tool_binding_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          },
          "uniqueItems": true
        },
        "transformation_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          },
          "uniqueItems": true
        },
        "ownership": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "enum": [
              "platform",
              "map-brand",
              "map-style",
              "map-layout",
              "map-scenario",
              "project"
            ]
          }
        },
        "shared_semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "theme_tags",
            "data_nature"
          ],
          "properties": {
            "theme_tags": {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/themeTags"
            },
            "data_nature": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "views": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "extent",
              "layer_ids",
              "target_ids"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/identifier"
              },
              "extent": {
                "$ref": "#/$defs/bbox"
              },
              "layer_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/identifier"
                }
              },
              "target_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "#/$defs/identifier"
                }
              }
            }
          }
        },
        "targets": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "format",
              "display_crs",
              "dpi"
            ],
            "properties": {
              "format": {
                "enum": [
                  "svg",
                  "pdf",
                  "png"
                ]
              },
              "display_crs": {
                "$ref": "#/$defs/crs"
              },
              "dpi": {
                "type": "integer",
                "minimum": 72,
                "maximum": 1200
              },
              "width_mm": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height_mm": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "resolved_assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceRef"
          },
          "uniqueItems": true
        },
        "resolved_layout": {
          "$ref": "https://schemas.carto-agent.local/v1/resolved-layout.schema.json"
        },
        "render_scene_ref": {
          "$ref": "#/$defs/artifactRef"
        },
        "renderer_profile_ref": {
          "$ref": "#/$defs/artifactRef"
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bounds",
            "bearing",
            "pitch"
          ],
          "properties": {
            "bounds": {
              "$ref": "#/$defs/bbox"
            },
            "bearing": {
              "type": "number",
              "minimum": 0,
              "maximum": 360
            },
            "pitch": {
              "type": "number",
              "minimum": 0,
              "maximum": 90
            },
            "padding": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "top",
                "right",
                "bottom",
                "left"
              ],
              "properties": {
                "top": {
                  "type": "number",
                  "minimum": 0
                },
                "right": {
                  "type": "number",
                  "minimum": 0
                },
                "bottom": {
                  "type": "number",
                  "minimum": 0
                },
                "left": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        },
        "overlay_coordinate_policy": {
          "enum": [
            "page",
            "viewport",
            "geographic",
            "feature"
          ]
        },
        "interaction_policy": {
          "enum": [
            "static",
            "preview",
            "interactive"
          ]
        },
        "environment": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "renderer_id",
                "renderer_version",
                "frontend_build",
                "maplibre_version",
                "overlay_engine_version",
                "fingerprint"
              ],
              "properties": {
                "renderer_id": {
                  "const": "maplibre-web"
                },
                "renderer_version": {
                  "$ref": "#/$defs/semanticVersion"
                },
                "frontend_build": {
                  "type": "string",
                  "minLength": 1
                },
                "maplibre_version": {
                  "type": "string",
                  "minLength": 1
                },
                "overlay_engine_version": {
                  "type": "string",
                  "minLength": 1
                },
                "fingerprint": {
                  "$ref": "#/$defs/digest"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "renderer_id",
                "renderer_version",
                "renderer_code_digest",
                "runtime",
                "fingerprint"
              ],
              "properties": {
                "renderer_id": {
                  "const": "rasterio-matplotlib-page"
                },
                "renderer_version": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
                },
                "renderer_code_digest": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
                },
                "runtime": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "python",
                    "rasterio",
                    "gdal",
                    "numpy",
                    "matplotlib",
                    "pillow",
                    "freetype",
                    "fonttools",
                    "zlib"
                  ],
                  "properties": {
                    "python": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                    },
                    "rasterio": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                    },
                    "gdal": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                    },
                    "numpy": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                    },
                    "matplotlib": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                    },
                    "pillow": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                    },
                    "freetype": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                    },
                    "fonttools": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                    },
                    "zlib": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128,
                      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                    }
                  }
                },
                "fingerprint": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
                }
              }
            }
          ]
        },
        "raster_inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prepared_bundle_ref",
            "page_request_ref"
          ],
          "properties": {
            "prepared_bundle_ref": {
              "allOf": [
                {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
                },
                {
                  "required": [
                    "uri"
                  ],
                  "properties": {
                    "id": {
                      "const": "prepared-data-bundle"
                    },
                    "version": {
                      "const": "1.0.0"
                    }
                  }
                }
              ]
            },
            "page_request_ref": {
              "allOf": [
                {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
                },
                {
                  "required": [
                    "uri"
                  ],
                  "properties": {
                    "id": {
                      "const": "raster-page-request"
                    },
                    "version": {
                      "const": "1.0.0"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "environment": {
                "properties": {
                  "renderer_id": {
                    "const": "rasterio-matplotlib-page"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "raster_inputs",
              "prepared_data_refs",
              "resolved_assets",
              "render_scene_ref"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "camera"
                  ]
                },
                {
                  "required": [
                    "overlay_coordinate_policy"
                  ]
                },
                {
                  "required": [
                    "interaction_policy"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "raster_inputs"
              ]
            }
          }
        }
      ]
    },
    "businessSceneId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[_-][a-z0-9]+)*$",
      "maxLength": 80,
      "description": "Business-purpose classification; membership is validated by the versioned intent catalog."
    },
    "themeTags": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
      }
    },
    "intentFields": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
        "not": {
          "enum": [
            "theme",
            "theme-tags",
            "business-scene",
            "tasks",
            "business-domain"
          ]
        }
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      },
      "description": "Declared contextual information. Field names must belong to the selected business-scene profile."
    },
    "intentSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fields"
      ],
      "properties": {
        "business_scene": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/businessSceneId"
        },
        "theme_tags": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/themeTags"
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          }
        },
        "fields": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/intentFields"
        },
        "requested_actions": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          }
        },
        "required_capabilities": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          }
        }
      },
      "description": "User intent, independent of template selection. Topic IDs are not business-scene IDs."
    }
  }
}
