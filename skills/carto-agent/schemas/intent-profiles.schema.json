{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.carto-agent.local/v1/intent-profiles.schema.json",
  "type": "object", "additionalProperties": false, "required": ["schema_version", "catalog_version", "profiles"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "catalog_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"},
    "profiles": {"type": "array", "minItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["scene_id", "task_ids", "required_information", "unsupported_actions"], "properties": {
      "scene_id": {"enum": ["government_thematic", "emergency_mapping", "leadership_visit"]},
      "task_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}},
      "required_information": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
      "unsupported_actions": {"type": "array", "items": {"type": "string", "minLength": 1}}
    }}}
  }
}
