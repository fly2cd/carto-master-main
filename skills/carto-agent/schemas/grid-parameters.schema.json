{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/grid-parameters.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rows",
    "columns",
    "legend_mode"
  ],
  "properties": {
    "rows": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "columns": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "legend_mode": {
      "enum": [
        "independent",
        "shared"
      ]
    },
    "legend_placement": {
      "description": "Optional legend placement (plan phase 3). Defaults to outside when omitted (legacy behavior). inside places each independent legend fully within its own main-map frame; shared+inside is not opened.",
      "enum": [
        "outside",
        "inside"
      ]
    }
  }
}
