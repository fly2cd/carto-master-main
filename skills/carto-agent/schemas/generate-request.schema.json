{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/generate-request.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "project_id",
    "goal",
    "geometry",
    "sources",
    "requested_outputs",
    "subject",
    "idempotency_key",
    "intent"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"
    },
    "request_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "project_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
      }
    },
    "material_sources": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "path"
        ],
        "properties": {
          "source_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "text/plain",
              "text/csv",
              "text/markdown",
              "application/json",
              "image/png",
              "image/jpeg",
              "image/tiff",
              "application/pdf"
            ]
          }
        }
      }
    },
    "requested_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "svg",
          "pdf",
          "png"
        ]
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "tenant_id",
        "namespace"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant_id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "namespace": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "approver_subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "run_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "scope": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$",
      "maxLength": 160
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "requested_at": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "namespace": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "kind": {
          "const": "map-scenario"
        },
        "id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "version": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
        },
        "digest": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
        }
      }
    },
    "allowed_capabilities": {
      "description": "User-declared capability grants. geo-to-image-pixels / image-display-bounds / annotation-layout are the image-basemap registration and callout layout capabilities required by scenarios that render onto a registered raster basemap; admitting them into the shared vocabulary is a data-type-level evolution, admission stays with scenario policy.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "read",
          "filter",
          "join",
          "classify",
          "reproject",
          "render-preview",
          "geo-to-image-pixels",
          "image-display-bounds",
          "annotation-layout"
        ]
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "family",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
        }
      }
    },
    "intent": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/intentSelection"
    },
    "geometry": {
      "enum": [
        "raster",
        "vector"
      ]
    },
    "segment_refs": {
      "description": "P4 project-level composition: replace scenario segments declared in replaceable_segments with exactly pinned published Style/Layout segments. Resolution happens at the contract load boundary through the trusted repository; the installed scenario package is never rewritten. Each segment has exactly one effective source: a request reference supersedes the author baseline (embedded or author-declared segment_refs) and is recorded in execution ownership and template_refs. Combining a replaced segment with a design override that owns the same segment (revised_cartography for style, output_profile for layout) is rejected as duplicate ownership.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "style": {
          "allOf": [
            {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/templateRef"
            },
            {
              "properties": {
                "kind": {
                  "const": "map-style"
                }
              }
            }
          ]
        },
        "layout": {
          "allOf": [
            {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/templateRef"
            },
            {
              "properties": {
                "kind": {
                  "const": "map-layout"
                }
              }
            }
          ]
        }
      }
    },
    "design_variants": {
      "description": "Optional externally supplied design variants for multi-candidate comparison. The program compiles each deterministically and never ranks or selects among them; selection is a separate external decision (select-candidate). Absent means single-candidate compilation.",
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id"
        ],
        "properties": {
          "variant_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "revised_cartography": {
            "$ref": "https://schemas.carto-agent.local/v2/style.schema.json"
          },
          "output_profile": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width_mm": {
                "type": "number",
                "minimum": 100,
                "maximum": 420
              },
              "height_mm": {
                "type": "number",
                "minimum": 100,
                "maximum": 297
              }
            }
          }
        }
      }
    }
  }
}
