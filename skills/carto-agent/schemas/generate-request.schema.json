{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.carto-agent.local/v1/generate-request.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "request_id", "project_id", "goal", "sources", "requested_outputs", "subject", "idempotency_key"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "request_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "project_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "goal": {"type": "string", "minLength": 1, "maxLength": 4000},
    "scene_hint": {"enum": ["government_thematic", "emergency_mapping", "leadership_visit"]},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"}},
    "requested_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["pdf", "png"]}},
    "subject": {"type": "object", "additionalProperties": false, "required": ["subject_id", "tenant_id", "namespace"], "properties": {"subject_id": {"type": "string", "minLength": 1}, "tenant_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}, "namespace": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}}},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128}
  }
}
