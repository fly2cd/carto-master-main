{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/generate-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "project_id",
    "goal",
    "geometry",
    "sources",
    "requested_outputs",
    "subject",
    "idempotency_key",
    "intent"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"
    },
    "request_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "project_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
      }
    },
    "material_sources": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "path"
        ],
        "properties": {
          "source_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "text/plain",
              "text/csv",
              "text/markdown",
              "application/json",
              "image/png",
              "image/jpeg",
              "image/tiff",
              "application/pdf"
            ]
          }
        }
      }
    },
    "requested_outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "svg",
          "pdf",
          "png"
        ]
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "tenant_id",
        "namespace"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "tenant_id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "namespace": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "approver_subject_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "run_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "audience": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "scope": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[a-z][a-z0-9-]*$",
      "maxLength": 160
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "requested_at": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "namespace": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "kind": {
          "const": "map-scenario"
        },
        "id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "version": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
        },
        "digest": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
        }
      }
    },
    "allowed_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "read",
          "filter",
          "join",
          "classify",
          "reproject",
          "render-preview"
        ]
      }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "role",
              "source_ref",
              "path",
              "format",
              "crs",
              "geometry_types",
              "field_bindings",
              "unit_bindings",
              "freshness",
              "join"
            ],
            "properties": {
              "role": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "source_ref": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "format": {
                "const": "geojson"
              },
              "crs": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/crs"
              },
              "geometry_types": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "point",
                    "multipoint",
                    "polygon",
                    "multipolygon"
                  ]
                }
              },
              "field_bindings": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "semantic_role",
                    "source_field",
                    "value_type"
                  ],
                  "properties": {
                    "semantic_role": {
                      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                    },
                    "source_field": {
                      "type": "string",
                      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                    },
                    "value_type": {
                      "enum": [
                        "integer",
                        "number"
                      ]
                    }
                  }
                }
              },
              "unit_bindings": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "semantic_role",
                    "unit"
                  ],
                  "properties": {
                    "semantic_role": {
                      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                    },
                    "unit": {
                      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                    }
                  }
                }
              },
              "freshness": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "observed_at",
                  "max_age_days"
                ],
                "properties": {
                  "observed_at": {
                    "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"
                  },
                  "max_age_days": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3650
                  }
                }
              },
              "join": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "required"
                ],
                "properties": {
                  "required": {
                    "type": "boolean"
                  },
                  "key": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  },
                  "coverage": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "minimum_coverage": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          },
          {
            "$ref": "https://schemas.carto-agent.local/v1/raster-input.schema.json"
          }
        ]
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "family",
        "version"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "family": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
        }
      }
    },
    "intent": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/intentSelection"
    },
    "geometry": {
      "enum": [
        "raster",
        "vector"
      ]
    },
    "prepared_raster_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "prepared_ref",
          "source_id"
        ],
        "properties": {
          "role": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "prepared_ref": {
            "allOf": [
              {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
              },
              {
                "required": [
                  "uri"
                ],
                "properties": {
                  "id": {
                    "const": "raster-prepared-data"
                  },
                  "version": {
                    "const": "1.0.0"
                  }
                }
              }
            ]
          },
          "source_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          }
        }
      }
    },
    "layout_parameters": {
      "anyOf": [
        {
          "$ref": "https://schemas.carto-agent.local/v1/grid-parameters.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "panels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_id",
          "title",
          "design"
        ],
        "properties": {
          "id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "source_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "pattern": "^[^\\x00-\\x1f\\x7f]+$"
          },
          "design": {
            "$ref": "https://schemas.carto-agent.local/v1/thematic-design.schema.json"
          }
        }
      }
    },
    "vector_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/vector-input.schema.json"
      }
    },
    "vector_panels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_id",
          "title",
          "extent",
          "design"
        ],
        "properties": {
          "id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "source_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "extent": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/bbox"
          },
          "design": {
            "$ref": "https://schemas.carto-agent.local/v1/thematic-design.schema.json"
          },
          "labels": {
            "description": "Optional feature-label annotation: name the property field whose values are drawn as labels. Absent means no feature labels.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field"
            ],
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "max_labels": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            }
          }
        }
      }
    },
    "revised_cartography": {
      "description": "Design revision cartography overrides applied during re-compile (R6). Only present on revised requests.",
      "$ref": "https://schemas.carto-agent.local/v2/cartography.schema.json"
    },
    "output_profile": {
      "description": "Optional page size override. When absent, the template's declared A4 landscape (297×210 mm) is used. Width/height must be within the scenario's output_constraints envelope (max 420×297 mm).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width_mm": {
          "type": "number",
          "minimum": 100,
          "maximum": 420
        },
        "height_mm": {
          "type": "number",
          "minimum": 100,
          "maximum": 297
        }
      }
    },
    "map_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60,
      "pattern": "^[^\\x00-\\x1f\\x7f]+$"
    },
    "design_variants": {
      "description": "Optional externally supplied design variants for multi-candidate comparison. The program compiles each deterministically and never ranks or selects among them; selection is a separate external decision (select-candidate). Absent means single-candidate compilation.",
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "variant_id"
        ],
        "properties": {
          "variant_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "revised_cartography": {
            "$ref": "https://schemas.carto-agent.local/v2/cartography.schema.json"
          },
          "output_profile": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width_mm": {
                "type": "number",
                "minimum": 100,
                "maximum": 420
              },
              "height_mm": {
                "type": "number",
                "minimum": 100,
                "maximum": 297
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "geometry": {
            "const": "raster"
          }
        },
        "required": [
          "geometry"
        ]
      },
      "then": {
        "required": [
          "panels"
        ],
        "not": {
          "required": [
            "vector_panels"
          ]
        }
      },
      "else": {
        "required": [
          "vector_panels"
        ],
        "not": {
          "required": [
            "panels"
          ]
        }
      }
    }
  ]
}
