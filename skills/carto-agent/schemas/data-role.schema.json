{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/data-role.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "roles"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "roles": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "required", "geometry_types", "fields", "license_policy"], "properties": {
      "id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
      "required": {"type": "boolean"},
      "geometry_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["none", "point", "multipoint", "line", "multiline", "polygon", "multipolygon", "raster"]}},
      "fields": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "type", "nullable"], "properties": {"name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}, "type": {"enum": ["string", "integer", "number", "boolean", "date", "datetime"]}, "unit": {"type": "string", "maxLength": 64}, "nullable": {"type": "boolean"}, "semantic_role": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}}}},
      "join": {"type": "object", "additionalProperties": false, "required": ["key", "minimum_coverage"], "properties": {"key": {"type": "string"}, "minimum_coverage": {"type": "number", "minimum": 0, "maximum": 1}}},
      "freshness": {"type": "object", "additionalProperties": false, "required": ["max_age_days"], "properties": {"max_age_days": {"type": "integer", "minimum": 0}}},
      "license_policy": {"enum": ["public", "project-approved", "restricted"]}
    }}}
  }
}
