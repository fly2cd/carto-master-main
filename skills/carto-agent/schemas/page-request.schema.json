{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/page-request.schema.json",
  "title": "page-request",
  "description": "Unified page contract. geometry selects the conditional body; identical layout/font/text/appearance/bindings fields are shared.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "appearance",
    "bindings",
    "font",
    "geometry",
    "grid_north",
    "legends",
    "resolved_layout",
    "scale_bar",
    "schema_version",
    "texts"
  ],
  "properties": {
    "appearance": {
      "$ref": "https://schemas.carto-agent.local/v2/resolved-appearance.schema.json"
    },
    "bindings": {
      "$ref": "https://schemas.carto-agent.local/v2/page-bindings.schema.json"
    },
    "resolved_layout": {
      "$ref": "https://schemas.carto-agent.local/v2/resolved-layout.schema.json"
    },
    "font": {
      "type": "object"
    },
    "grid_north": {
      "type": "null"
    },
    "basemap": {
      "type": "object"
    },
    "layer_stack": {
      "type": "array"
    },
    "charts": {
      "type": "array"
    },
    "legends": {
      "type": "array"
    },
    "scale_bar": {
      "type": "null"
    },
    "texts": {
      "type": "array"
    },
    "portrayals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "view_id",
          "ref"
        ],
        "properties": {
          "view_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "ref": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
          }
        }
      }
    },
    "style": {
      "$ref": "https://schemas.carto-agent.local/v2/style.schema.json"
    },
    "coordinate_mode": {
      "const": "native-no-reprojection"
    },
        "panels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "view_id",
              "frame_id",
              "portrayal_ref",
              "extent"
            ],
            "properties": {
              "view_id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "frame_id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "portrayal_ref": {
                "allOf": [
                  {
                    "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
                  },
                  {
                    "required": [
                      "uri"
                    ]
                  }
                ]
              },
              "extent": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          {
            "description": "Ordered thematic layer stack: later layers paint above earlier ones within the same frame.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "view_id",
              "frame_id",
              "layers",
              "extent"
            ],
            "properties": {
              "view_id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "frame_id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "layers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "portrayal_ref"
                  ],
                  "properties": {
                    "portrayal_ref": {
                      "allOf": [
                        {
                          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
                        },
                        {
                          "required": [
                            "uri"
                          ]
                        }
                      ]
                    }
                  }
                }
              },
              "extent": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        ]
      }
    },
    "geometry": {
      "enum": [
        "raster",
        "vector"
      ]
    },
    "schema_version": {
      "const": 4
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "geometry": {
            "const": "raster"
          }
        }
      },
      "then": {
        "required": [
          "appearance",
          "bindings",
          "font",
          "geometry",
          "grid_north",
          "legends",
          "portrayals",
          "resolved_layout",
          "scale_bar",
          "texts"
        ],
        "not": {
          "required": [
            "style",
            "coordinate_mode",
            "panels"
          ]
        },
        "properties": {
          "font": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest",
              "size_bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "digest": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 33554432
              }
            }
          },
          "grid_north": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content_id",
                  "label"
                ],
                "properties": {
                  "content_id": {
                    "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                  },
                  "label": {
                    "enum": [
                      "Grid north",
                      "格网北"
                    ]
                  }
                }
              }
            ]
          },
          "layer_stack": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 4,
            "maxItems": 5,
            "description": "Frozen paint order: who covers whom is cartographic semantics, not convention. The compiler emits the canonical order; the renderer asserts it before drawing.",
            "items": {
              "enum": [
                "basemap",
                "thematic",
                "legends",
                "charts",
                "furniture"
              ]
            }
          },
          "basemap": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "image",
              "crs",
              "extent"
            ],
            "properties": {
              "image": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "digest",
                  "size_bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 268435456
                  }
                }
              },
              "crs": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "authority",
                  "code"
                ],
                "properties": {
                  "authority": {
                    "const": "EPSG"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                }
              },
              "extent": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "style": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "desaturate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "lighten": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  }
                }
              }
            }
          },
          "charts": {
            "type": "array",
            "minItems": 0,
            "maxItems": 4,
            "items": {
              "$ref": "https://schemas.carto-agent.local/v1/chart.schema.json"
            }
          },
          "legends": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content_id",
                "title",
                "items"
              ],
              "properties": {
                "content_id": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                },
                "items": {
                  "type": "array",
                  "maxItems": 256,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "value",
                      "label",
                      "color",
                      "order"
                    ],
                    "properties": {
                      "value": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 4294967295
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                      },
                      "color": {
                        "type": "string",
                        "pattern": "^#[0-9A-F]{6}$"
                      },
                      "order": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1023
                      }
                    }
                  }
                }
              }
            }
          },
          "scale_bar": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content_id",
                  "distance_m",
                  "label_language"
                ],
                "properties": {
                  "content_id": {
                    "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                  },
                  "distance_m": {
                    "type": "number",
                    "minimum": 0.001,
                    "maximum": 40000000
                  },
                  "label_language": {
                    "enum": [
                      "en",
                      "zh"
                    ]
                  }
                }
              }
            ]
          },
          "texts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content_id",
                "text"
              ],
              "properties": {
                "content_id": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^[^\\x00-\\x09\\x0b-\\x1f\\x7f]+$"
                }
              }
            }
          }
        }
      },
      "else": {
        "required": [
          "appearance",
          "bindings",
          "style",
          "coordinate_mode",
          "font",
          "geometry",
          "grid_north",
          "legends",
          "panels",
          "resolved_layout",
          "scale_bar",
          "texts"
        ],
        "not": {
          "required": [
            "portrayals"
          ]
        },
        "properties": {
          "font": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest",
              "size_bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "digest": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 33554432
              }
            }
          },
          "grid_north": {
            "type": "null"
          },
          "layer_stack": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 4,
            "maxItems": 5,
            "description": "Frozen paint order: who covers whom is cartographic semantics, not convention. The compiler emits the canonical order; the renderer asserts it before drawing.",
            "items": {
              "enum": [
                "basemap",
                "thematic",
                "legends",
                "charts",
                "furniture"
              ]
            }
          },
          "basemap": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "image",
              "crs",
              "extent"
            ],
            "properties": {
              "image": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "path",
                  "digest",
                  "size_bytes"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "size_bytes": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 268435456
                  }
                }
              },
              "crs": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "authority",
                  "code"
                ],
                "properties": {
                  "authority": {
                    "const": "EPSG"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]+$"
                  }
                }
              },
              "extent": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              },
              "style": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "desaturate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "lighten": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 1
                  }
                }
              }
            }
          },
          "charts": {
            "type": "array",
            "minItems": 0,
            "maxItems": 4,
            "items": {
              "$ref": "https://schemas.carto-agent.local/v1/chart.schema.json"
            }
          },
          "legends": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content_id",
                "title",
                "view_ids",
                "items"
              ],
              "properties": {
                "content_id": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                },
                "view_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                  }
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 33,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "label",
                      "symbol",
                      "shape"
                    ],
                    "properties": {
                      "id": {
                        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                      },
                      "symbol": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "color",
                          "stroke",
                          "stroke_width_pt",
                          "radius_mm"
                        ],
                        "properties": {
                          "color": {
                            "type": "string",
                            "pattern": "^#[0-9A-F]{6}$"
                          },
                          "stroke": {
                            "type": "string",
                            "pattern": "^#[0-9A-F]{6}$"
                          },
                          "stroke_width_pt": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 5
                          },
                          "radius_mm": {
                            "type": "number",
                            "minimum": 1e-06,
                            "maximum": 20
                          }
                        }
                      },
                      "shape": {
                        "enum": [
                          "circle",
                          "line",
                          "square"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "scale_bar": {
            "type": "null"
          },
          "texts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content_id",
                "text"
              ],
              "properties": {
                "content_id": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                }
              }
            }
          }
        }
      }
    }
  ]
}
