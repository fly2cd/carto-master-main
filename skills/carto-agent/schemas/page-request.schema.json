{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/page-request.schema.json",
  "title": "page-request",
  "description": "Unified page contract. Three orthogonal axes: expression selects the map-body machinery (portrayal layers vs a registered canvas carrying overlay graphics), geometry names the thematic data form (raster/vector), coordinate_mode declares the drawing space. Layout/font/text/legend fields and the frozen component paint order (layer_stack) are shared by every expression.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "expression",
    "font",
    "geometry",
    "grid_north",
    "layer_stack",
    "legends",
    "resolved_layout",
    "scale_bar",
    "schema_version",
    "texts"
  ],
  "properties": {
    "appearance": {
      "$ref": "https://schemas.carto-agent.local/v2/resolved-appearance.schema.json"
    },
    "bindings": {
      "$ref": "https://schemas.carto-agent.local/v2/page-bindings.schema.json"
    },
    "resolved_layout": {
      "$ref": "https://schemas.carto-agent.local/v2/resolved-layout.schema.json"
    },
    "font": {
      "type": "object"
    },
    "grid_north": {
      "type": "null"
    },
    "basemap": {
      "$ref": "https://schemas.carto-agent.local/v1/basemap.schema.json"
    },
    "expression": {
      "enum": [
        "portrayal",
        "canvas-overlay"
      ]
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "graphics_digest"
      ],
      "description": "Canvas map-body declaration: binds this page to the exact frozen overlay graphics the render scene carries (scene.image_graphics). Compiler and final check re-verify the digest so the page contract and the rendered content cannot drift apart.",
      "properties": {
        "graphics_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category"
      ],
      "properties": {
        "category": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/businessSceneId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "geo": {
          "description": "Frozen online-view sections (frontend-map-document baseMap/mapData shapes) computed at compile when the request declares online_basemap. Carried on the page contract so BOTH renderers deterministically rebuild the same document from the same frozen inputs.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseMap",
            "mapData"
          ],
          "properties": {
            "baseMap": {
              "$ref": "https://schemas.carto-agent.local/v1/frontend-map-document.schema.json#/$defs/baseMapSection"
            },
            "mapData": {
              "$ref": "https://schemas.carto-agent.local/v1/frontend-map-document.schema.json#/$defs/mapDataSection"
            }
          }
        }
      }
    },
    "furniture": {
      "type": "object",
      "additionalProperties": false,
      "description": "Frozen page furniture: the map frame border carried from the style contract's page_furniture section. Consumed identically by both renderers.",
      "properties": {
        "frame_border": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "color",
            "inner_width_mm",
            "gap_mm",
            "outer_width_mm"
          ],
          "properties": {
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "inner_width_mm": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 5
            },
            "gap_mm": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            },
            "outer_width_mm": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 5
            }
          }
        }
      }
    },
    "layer_stack": {
      "type": "array"
    },
    "charts": {
      "type": "array"
    },
    "legends": {
      "type": "array"
    },
    "scale_bar": {
      "type": "null"
    },
    "texts": {
      "type": "array"
    },
    "portrayals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "view_id",
          "ref"
        ],
        "properties": {
          "view_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "ref": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
          }
        }
      }
    },
    "style": {
      "$ref": "https://schemas.carto-agent.local/v2/style.schema.json"
    },
    "coordinate_mode": {
      "enum": [
        "native-no-reprojection",
        "image-pixel-registration"
      ]
    },
        "panels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "view_id",
              "frame_id",
              "portrayal_ref",
              "extent"
            ],
            "properties": {
              "view_id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "frame_id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "portrayal_ref": {
                "allOf": [
                  {
                    "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
                  },
                  {
                    "required": [
                      "uri"
                    ]
                  }
                ]
              },
              "extent": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              }
            }
          },
          {
            "description": "Ordered thematic layer stack: later layers paint above earlier ones within the same frame.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "view_id",
              "frame_id",
              "layers",
              "extent"
            ],
            "properties": {
              "view_id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "frame_id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "layers": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "portrayal_ref"
                  ],
                  "properties": {
                    "portrayal_ref": {
                      "allOf": [
                        {
                          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
                        },
                        {
                          "required": [
                            "uri"
                          ]
                        }
                      ]
                    }
                  }
                }
              },
              "extent": {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {
                  "type": "number"
                }
              }
            }
          }
        ]
      }
    },
    "geometry": {
      "enum": [
        "raster",
        "vector"
      ]
    },
    "schema_version": {
      "const": 5
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "expression": {
            "const": "portrayal"
          }
        },
        "required": [
          "expression"
        ]
      },
      "then": {
        "required": [
          "appearance",
          "bindings"
        ],
        "not": {
          "anyOf": [
            {"required": ["overlay"]},
            {"required": ["document"]}
          ]
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "geometry": {
                  "const": "raster"
                }
              }
            },
      "then": {
        "required": [
          "appearance",
          "bindings",
          "font",
          "geometry",
          "grid_north",
          "legends",
          "portrayals",
          "resolved_layout",
          "scale_bar",
          "texts"
        ],
        "not": {
          "anyOf": [
            {"required": ["style"]},
            {"required": ["coordinate_mode"]},
            {"required": ["panels"]}
          ]
        },
        "properties": {
          "font": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest",
              "size_bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "digest": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 33554432
              }
            }
          },
          "grid_north": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content_id",
                  "label"
                ],
                "properties": {
                  "content_id": {
                    "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                  },
                  "label": {
                    "enum": [
                      "Grid north",
                      "格网北"
                    ]
                  }
                }
              }
            ]
          },
          "layer_stack": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 4,
            "maxItems": 5,
            "description": "Frozen paint order: who covers whom is cartographic semantics, not convention. The compiler emits the canonical order; the renderer asserts it before drawing.",
            "items": {
              "enum": [
                "basemap",
                "thematic",
                "legends",
                "charts",
                "furniture"
              ]
            }
          },
          "basemap": {
            "$ref": "https://schemas.carto-agent.local/v1/basemap.schema.json"
          },
          "charts": {
            "type": "array",
            "minItems": 0,
            "maxItems": 4,
            "items": {
              "$ref": "https://schemas.carto-agent.local/v1/chart.schema.json"
            }
          },
          "legends": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content_id",
                "title",
                "items"
              ],
              "properties": {
                "content_id": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                },
                "items": {
                  "type": "array",
                  "maxItems": 256,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "value",
                      "label",
                      "color",
                      "order"
                    ],
                    "properties": {
                      "value": {
                        "type": "integer",
                        "minimum": -2147483648,
                        "maximum": 4294967295
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                      },
                      "color": {
                        "type": "string",
                        "pattern": "^#[0-9A-F]{6}$"
                      },
                      "order": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1023
                      }
                    }
                  }
                }
              }
            }
          },
          "scale_bar": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content_id",
                  "distance_m",
                  "label_language"
                ],
                "properties": {
                  "content_id": {
                    "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                  },
                  "distance_m": {
                    "type": "number",
                    "minimum": 0.001,
                    "maximum": 40000000
                  },
                  "label_language": {
                    "enum": [
                      "en",
                      "zh"
                    ]
                  }
                }
              }
            ]
          },
          "texts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content_id",
                "text"
              ],
              "properties": {
                "content_id": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^[^\\x00-\\x09\\x0b-\\x1f\\x7f]+$"
                }
              }
            }
          }
        }
      },
      "else": {
        "required": [
          "appearance",
          "bindings",
          "style",
          "coordinate_mode",
          "font",
          "geometry",
          "grid_north",
          "legends",
          "panels",
          "resolved_layout",
          "scale_bar",
          "texts"
        ],
        "not": {
          "required": [
            "portrayals"
          ]
        },
        "properties": {
          "coordinate_mode": {
            "const": "native-no-reprojection"
          },
          "font": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest",
              "size_bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "digest": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 33554432
              }
            }
          },
          "grid_north": {
            "type": "null"
          },
          "layer_stack": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 4,
            "maxItems": 5,
            "description": "Frozen paint order: who covers whom is cartographic semantics, not convention. The compiler emits the canonical order; the renderer asserts it before drawing.",
            "items": {
              "enum": [
                "basemap",
                "thematic",
                "legends",
                "charts",
                "furniture"
              ]
            }
          },
          "basemap": {
            "$ref": "https://schemas.carto-agent.local/v1/basemap.schema.json"
          },
          "charts": {
            "type": "array",
            "minItems": 0,
            "maxItems": 4,
            "items": {
              "$ref": "https://schemas.carto-agent.local/v1/chart.schema.json"
            }
          },
          "legends": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content_id",
                "title",
                "view_ids",
                "items"
              ],
              "properties": {
                "content_id": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                },
                "view_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                  }
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 33,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "label",
                      "symbol",
                      "shape"
                    ],
                    "properties": {
                      "id": {
                        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                      },
                      "symbol": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "color",
                          "stroke",
                          "stroke_width_pt",
                          "radius_mm"
                        ],
                        "properties": {
                          "color": {
                            "type": "string",
                            "pattern": "^#[0-9A-F]{6}$"
                          },
                          "stroke": {
                            "type": "string",
                            "pattern": "^#[0-9A-F]{6}$"
                          },
                          "stroke_width_pt": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 5
                          },
                          "radius_mm": {
                            "type": "number",
                            "minimum": 1e-06,
                            "maximum": 20
                          }
                        }
                      },
                      "shape": {
                        "enum": [
                          "circle",
                          "line",
                          "square"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "scale_bar": {
            "type": "null"
          },
          "texts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content_id",
                "text"
              ],
              "properties": {
                "content_id": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                }
              }
            }
          }
        }
      }
          }
        ]
      },
      "else": {
        "required": [
          "basemap",
          "coordinate_mode",
          "overlay"
        ],
        "not": {
          "anyOf": [
            {"required": ["appearance"]},
            {"required": ["bindings"]},
            {"required": ["portrayals"]},
            {"required": ["panels"]},
            {"required": ["style"]},
            {"required": ["charts"]}
          ]
        },
        "properties": {
          "geometry": {
            "const": "vector"
          },
          "coordinate_mode": {
            "const": "image-pixel-registration"
          },
          "basemap": {
            "$ref": "https://schemas.carto-agent.local/v1/basemap.schema.json",
            "required": [
              "source_size",
              "display_window"
            ]
          },
          "grid_north": {
            "type": "null"
          },
          "scale_bar": {
            "type": "null"
          },
          "layer_stack": {
            "type": "array",
            "uniqueItems": true,
            "minItems": 4,
            "maxItems": 4,
            "description": "Frozen paint order of the canvas page: basemap, overlay graphics (thematic), page furniture (texts and frame border), then legends — exactly the order the image renderer paints. Who covers whom is cartographic semantics, not convention.",
            "items": {
              "enum": [
                "basemap",
                "thematic",
                "legends",
                "furniture"
              ]
            }
          },
          "font": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "digest",
              "size_bytes"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "^[^\\x00-\\x1f\\x7f]+$"
              },
              "digest": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 33554432
              }
            }
          },
          "texts": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content_id",
                "text"
              ],
              "properties": {
                "content_id": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2048,
                  "pattern": "^[^\\x00-\\x09\\x0b-\\x1f\\x7f]+$"
                },
                "font_pt": {
                  "type": "number",
                  "minimum": 4,
                  "maximum": 72,
                  "description": "Frozen nominal furniture font (points) from the style contract's page_furniture; absent means the renderers' historical nominal applies."
                }
              }
            }
          },
          "legends": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "content_id",
                "title",
                "items"
              ],
              "properties": {
                "content_id": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "id",
                      "label",
                      "color",
                      "shape"
                    ],
                    "properties": {
                      "id": {
                        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                      },
                      "label": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256,
                        "pattern": "^[^\\x00-\\x1f\\x7f]+$"
                      },
                      "color": {
                        "type": "string",
                        "pattern": "^#[0-9A-Fa-f]{6}$"
                      },
                      "shape": {
                        "enum": [
                          "line",
                          "pin",
                          "circle"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
