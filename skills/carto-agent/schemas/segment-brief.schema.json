{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/segment-brief.schema.json",
  "description": "Design-intent brief for an independent segment template (map-style/map-layout). Unlike template-brief (scenario), it has no data sources, source-license summary, data roles or spatial applicability/CRS: segments are reusable appearance/layout contracts. The design is bound by design_digest; evidence records reuse the shared evidenceRecord definition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "kind",
    "namespace",
    "template_id",
    "version",
    "scope",
    "purpose",
    "audience",
    "reuse_intent",
    "supported_uses",
    "excluded_uses",
    "authoring_mode",
    "targets",
    "design_digest",
    "evidence_records",
    "decisions",
    "open_questions",
    "revision"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "brief_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "kind": {"enum": ["map-style", "map-layout"]},
    "namespace": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "template_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"},
    "scope": {"type": "string", "pattern": "^project:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$", "maxLength": 128},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 1000},
    "audience": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "reuse_intent": {"type": "string", "minLength": 1, "maxLength": 500},
    "supported_uses": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}
    },
    "excluded_uses": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}
    },
    "authoring_mode": {"enum": ["standard", "fidelity", "mirror"]},
    "targets": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"enum": ["svg", "pdf", "png"]}
    },
    "design_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "evidence_records": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "https://schemas.carto-agent.local/v1/template-analysis.schema.json#/$defs/evidenceRecord"}
    },
    "decisions": {
      "type": "array",
      "items": {"$ref": "https://schemas.carto-agent.local/v1/template-analysis.schema.json#/$defs/evidenceRecord"}
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "revision": {"type": "integer", "minimum": 1}
  }
}