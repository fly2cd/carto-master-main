{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/state-transition.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "transition_id", "run_id", "expected_revision", "receipt_path", "receipt_digest", "previous_state", "next_state", "created_at"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "transition_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "run_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "expected_revision": {"type": "integer", "minimum": 1},
    "receipt_path": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/relativePath"},
    "receipt_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "previous_state": {"$ref": "https://schemas.carto-agent.local/v1/job-state.schema.json"},
    "next_state": {"$ref": "https://schemas.carto-agent.local/v1/job-state.schema.json"},
    "created_at": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"}
  }
}
