{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/render-attempt.schema.json",
  "title": "Immutable formal render attempt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "attempt_id", "project_id", "run_id", "lock_ref", "lock_digest",
    "business_execution_digest", "target_id", "attempt_number", "status",
    "render_scene_digest", "renderer_profile_digest", "environment_fingerprint",
    "retryable", "started_at", "completed_at"
  ],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "attempt_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "project_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "run_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "lock_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"},
    "lock_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "business_execution_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "target_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "attempt_number": {"type": "integer", "minimum": 1},
    "status": {"enum": ["succeeded", "failed"]},
    "render_scene_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "renderer_profile_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "renderer_execution_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "resource_set_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "environment_fingerprint": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "previous_attempt_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"},
    "output_artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target", "artifact_ref"],
        "properties": {
          "target": {"enum": ["svg", "png", "pdf"]},
          "artifact_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"}
        }
      }
    },
    "render_receipt_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"},
    "retryable": {"type": "boolean"},
    "retry_reason": {"type": "string", "minLength": 1, "maxLength": 512},
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 128},
        "message": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "started_at": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"},
    "completed_at": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "succeeded"}}, "required": ["status"]},
      "then": {
        "required": ["renderer_execution_digest", "resource_set_digest", "output_artifacts", "render_receipt_ref"],
        "properties": {"retryable": {"const": false}},
        "not": {"anyOf": [{"required": ["error"]}, {"required": ["retry_reason"]}]}
      },
      "else": {
        "required": ["error"],
        "not": {"anyOf": [
          {"required": ["renderer_execution_digest"]},
          {"required": ["resource_set_digest"]},
          {"required": ["output_artifacts"]},
          {"required": ["render_receipt_ref"]}
        ]}
      }
    },
    {
      "if": {"properties": {"retryable": {"const": true}}, "required": ["retryable"]},
      "then": {"required": ["retry_reason"]}
    }
  ]
}
