{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/validation-host.schema.json",
  "description": "Platform validation-host binding for independent segment validation. The host is a deterministic synthetic scenario shell (canonical style + layout + spatial_behavior + portrayal + fixture) built from the admitted scenario's contract builders; it is NOT a published business template and never enters the business index. Segment validation injects the segment-under-test into the shell's embedded slot and reuses the scenario validation_scene + generic raster renderer. ID/version pin the host; any drift invalidates prior evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "host_id",
    "version",
    "shell_digest",
    "style_digest",
    "layout_digest",
    "fixture_digest",
    "display_crs",
    "output_profile"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "host_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"},
    "shell_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "style_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "layout_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "fixture_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "display_crs": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/crs"},
    "output_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["width_mm", "height_mm", "dpi"],
      "properties": {
        "width_mm": {"type": "number", "exclusiveMinimum": 0},
        "height_mm": {"type": "number", "exclusiveMinimum": 0},
        "dpi": {"type": "integer", "minimum": 1}
      }
    }
  }
}