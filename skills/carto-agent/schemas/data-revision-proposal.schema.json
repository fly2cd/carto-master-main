{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/data-revision-proposal.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "run_id",
    "parent_revision",
    "changes",
    "outbound_declaration",
    "justification"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"
    },
    "proposal_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "parent_revision": {
      "type": "integer",
      "minimum": 1
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "route_legs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "leg_id",
              "via_points"
            ],
            "properties": {
              "leg_id": {
                "type": "string",
                "minLength": 1
              },
              "via_points": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "lon",
                    "lat"
                  ],
                  "properties": {
                    "lon": {
                      "type": "number"
                    },
                    "lat": {
                      "type": "number"
                    }
                  }
                }
              },
              "strategy": {
                "type": "string",
                "pattern": "^[0-6]$"
              }
            }
          }
        }
      }
    },
    "outbound_declaration": {
      "description": "Place names (name + city) that will be sent to the external geocoding/routing provider while executing this revision. The G1D approval digest covers this declaration: outbound authorization is digest-bound, not conversational.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "city"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "city": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "justification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
