{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/delivery-transaction.schema.json",
  "title": "Recoverable local delivery transaction journal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "transaction_id", "delivery_id", "project_id", "tenant_id", "run_id",
    "manifest_ref", "manifest_digest", "idempotency_key", "recipient", "destination",
    "staging_path", "final_path", "approval_ref", "status", "phase", "artifacts",
    "created_at", "updated_at"
  ],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "transaction_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "delivery_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "project_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "tenant_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "run_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "manifest_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"},
    "manifest_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "idempotency_key": {"type": "string", "minLength": 16, "maxLength": 128},
    "recipient": {
      "type": "object", "additionalProperties": false,
      "required": ["recipient_id", "recipient_type"],
      "properties": {
        "recipient_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
        "recipient_type": {"enum": ["project-user", "project-team"]}
      }
    },
    "destination": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "relative_path"],
      "properties": {
        "kind": {"const": "local-allowed-root"},
        "relative_path": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/relativePath"}
      }
    },
    "staging_path": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/relativePath"},
    "final_path": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/relativePath"},
    "approval_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"},
    "status": {"enum": ["intent-created", "staged", "committed", "receipt-written", "failed"]},
    "phase": {"enum": ["intent", "staging", "commit", "receipt", "failed"]},
    "artifacts": {
      "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "format", "digest", "size_bytes"],
        "properties": {
          "path": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/relativePath"},
          "format": {"enum": ["pdf", "png"]},
          "digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      },
      "contains": {"type": "object", "required": ["format"], "properties": {"format": {"const": "pdf"}}},
      "minContains": 1, "maxContains": 1,
      "allOf": [{"contains": {"type": "object", "required": ["format"], "properties": {"format": {"const": "png"}}}, "minContains": 1, "maxContains": 1}]
    },
    "receipt_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"},
    "created_at": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"},
    "committed_at": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"},
    "error": {
      "type": "object", "additionalProperties": false, "required": ["code", "message"],
      "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}
    }
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "intent-created"}}}, "then": {"properties": {"phase": {"enum": ["intent", "staging"]}}, "not": {"required": ["committed_at"]}}},
    {"if": {"properties": {"status": {"const": "staged"}}}, "then": {"properties": {"phase": {"const": "commit"}}, "not": {"required": ["committed_at"]}}},
    {"if": {"properties": {"status": {"const": "committed"}}}, "then": {"properties": {"phase": {"const": "receipt"}}, "required": ["committed_at"]}},
    {"if": {"properties": {"status": {"const": "receipt-written"}}}, "then": {"properties": {"phase": {"const": "receipt"}}, "required": ["committed_at", "receipt_ref"]}},
    {"if": {"properties": {"status": {"const": "failed"}}}, "then": {"properties": {"phase": {"const": "failed"}}, "required": ["error"]}}
  ]
}
