{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/annotation-layout-request.schema.json",
  "title": "annotation-layout-request",
  "description": "Typed input for the annotation-layout capability: callout boxes, hard obstacles (route strokes, pin symbols, fixed cards) and the canvas the bounded greedy + simulated-annealing solver must respect. Determinism comes from the request-supplied seed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "items",
    "hard_lines",
    "hard_boxes",
    "canvas",
    "gap_px",
    "seed",
    "iterations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "anchor_x", "anchor_y", "w", "h"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "anchor_x": {
            "type": "number"
          },
          "anchor_y": {
            "type": "number"
          },
          "w": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "h": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "fixed": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y"],
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "hard_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["points", "width_px"],
        "properties": {
          "points": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/point"
            }
          },
          "width_px": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "hard_boxes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/box"
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "gap_px": {
      "type": "number",
      "minimum": 0
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "iterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "w": {
          "type": "number",
          "minimum": 0
        },
        "h": {
          "type": "number",
          "minimum": 0
        }
      }
    }
  }
}
