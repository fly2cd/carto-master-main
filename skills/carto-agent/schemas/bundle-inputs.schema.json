{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/bundle-inputs.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inputs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "prepared_ref"
        ],
        "properties": {
          "source_id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "prepared_ref": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
          }
        }
      }
    }
  }
}
