{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/image-projection-result.schema.json",
  "title": "image-projection-result",
  "description": "Typed output of the geo-to-image-pixels capability: the frozen projection document (ordered stops and clipped route parts in original-image pixel coordinates).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "method",
    "method_version",
    "pixel_convention",
    "source_size",
    "stops",
    "routes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "method": {
      "const": "registered-affine"
    },
    "method_version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
    },
    "pixel_convention": {
      "const": "image-edge; x-right; y-down; center-offset-applied-once"
    },
    "source_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_px", "height_px"],
      "properties": {
        "width_px": {
          "type": "integer",
          "minimum": 1
        },
        "height_px": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stops": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_id", "visit_order", "position"],
        "properties": {
          "feature_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "visit_order": {
            "type": "integer",
            "minimum": 1
          },
          "position": {
            "$ref": "#/$defs/pixelPoint"
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["feature_id", "parts", "original_parts", "outside_vertex_count", "route_mode"],
        "properties": {
          "feature_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/pixelPoint"
              }
            }
          },
          "original_parts": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "#/$defs/pixelPoint"
              }
            }
          },
          "outside_vertex_count": {
            "type": "integer",
            "minimum": 0
          },
          "route_mode": {
            "enum": ["road_network", "provided_geometry", "schematic", "straight_line"]
          }
        }
      }
    }
  },
  "$defs": {
    "pixelPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    }
  }
}
