{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/geospatial-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "source"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "operation": {
      "enum": [
        "info",
        "statistics",
        "reproject"
      ]
    },
    "source": {
      "$ref": "https://schemas.carto-agent.local/v1/raster-input.schema.json"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_crs",
        "resolution",
        "resampling"
      ],
      "properties": {
        "target_crs": {
          "type": "string",
          "pattern": "^EPSG:[1-9][0-9]{2,5}$"
        },
        "resolution": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "resampling": {
          "const": "nearest"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "reproject"
          }
        }
      },
      "then": {
        "required": [
          "parameters"
        ]
      },
      "else": {
        "not": {
          "required": [
            "parameters"
          ]
        }
      }
    }
  ]
}
