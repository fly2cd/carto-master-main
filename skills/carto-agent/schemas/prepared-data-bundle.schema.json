{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/prepared-data-bundle.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bundle_id",
    "task_ref",
    "datasets",
    "transformations",
    "tool_receipts",
    "quality_evidence",
    "open_issues",
    "digest"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"
    },
    "bundle_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "task_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
      }
    },
    "transformations": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
      }
    },
    "tool_receipts": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
      }
    },
    "quality_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
      }
    },
    "open_issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "digest": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
    },
    "role_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "dataset_ref",
          "prepared_ref",
          "geometry_types",
          "semantic_fields",
          "feature_count",
          "bbox",
          "crs",
          "observed_at",
          "join_coverage"
        ],
        "properties": {
          "role": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "dataset_ref": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
          },
          "prepared_ref": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
          },
          "geometry_types": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "semantic_fields": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "feature_count": {
            "type": "integer",
            "minimum": 1
          },
          "bbox": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/bbox"
          },
          "crs": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/crs"
          },
          "observed_at": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"
          },
          "join_coverage": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "combined_bbox",
        "data_nature"
      ],
      "properties": {
        "combined_bbox": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/bbox"
        },
        "data_nature": {
          "const": "synthetic"
        }
      }
    }
  }
}
