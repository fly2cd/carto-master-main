{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/extraction-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_id", "source_ref", "extracted_at", "content_type", "fields", "digest"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "result_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "source_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"},
    "extracted_at": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"},
    "content_type": {"type": "string", "enum": ["text", "tabular", "image", "mixed"]},
    "source_format": {"type": "string", "minLength": 1, "maxLength": 128},
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "data_type"],
        "properties": {
          "name": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
          "data_type": {"type": "string", "enum": ["string", "integer", "number", "boolean", "datetime"]},
          "nullable": {"type": "boolean", "default": true},
          "semantic_role": {"type": "string", "minLength": 1}
        }
      }
    },
    "row_count": {"type": "integer", "minimum": 0, "maximum": 100000},
    "byte_length": {"type": "integer", "minimum": 0, "maximum": 268435456},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "cells", "source_location"],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "cells": {"type": "object", "additionalProperties": true},
          "source_location": {
            "type": "object",
            "additionalProperties": false,
            "required": ["line_start", "line_end"],
            "properties": {
              "line_start": {"type": "integer", "minimum": 1},
              "line_end": {"type": "integer", "minimum": 1},
              "byte_offset": {"type": "integer", "minimum": 0},
              "byte_length": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    "text_content": {"type": "string", "maxLength": 1048576},
    "image_metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "color_mode": {"type": "string"},
        "dpi": {"type": "integer", "minimum": 1}
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "message"],
        "properties": {
          "severity": {"type": "string", "enum": ["warning", "error"]},
          "message": {"type": "string", "minLength": 1},
          "location": {"type": "string"}
        }
      }
    },
    "digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"}
  }
}