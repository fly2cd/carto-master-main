{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/scenario-capabilities.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "default",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
    },
    "default": {
      "const": "deny"
    },
    "profiles": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "implementation",
          "template",
          "authoring_profile",
          "request_schemas",
          "intent_constraints",
          "data_nature",
          "production_enabled",
          "notice",
          "licenses",
          "output_profile",
          "internal_field_names"
        ],
        "properties": {
          "id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "version": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
          },
          "implementation": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "template": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "id",
              "version"
            ],
            "properties": {
              "kind": {
                "const": "map-scenario"
              },
              "id": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "version": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
              }
            }
          },
          "authoring_profile": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "request_schemas": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "create-template",
              "generate-map"
            ],
            "properties": {
              "create-template": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "generate-map": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              }
            }
          },
          "data_nature": {
            "type": "string",
            "minLength": 1
          },
          "production_enabled": {
            "const": false
          },
          "notice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "licenses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
            }
          },
          "output_profile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width_mm",
              "height_mm",
              "dpi",
              "width_px",
              "height_px"
            ],
            "properties": {
              "width_mm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "height_mm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "dpi": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "width_px": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "height_px": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            }
          },
          "internal_field_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "intent_constraints": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "business_scene",
              "allowed_theme_tags",
              "required_theme_tags",
              "allowed_tasks"
            ],
            "properties": {
              "business_scene": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/businessSceneId"
              },
              "allowed_theme_tags": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/themeTags"
              },
              "required_theme_tags": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/themeTags"
              },
              "allowed_tasks": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                }
              }
            }
          }
        }
      }
    }
  }
}
