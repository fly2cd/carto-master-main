{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/scenario-capabilities.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "default",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
    },
    "default": {
      "const": "deny"
    },
    "profiles": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "implementation",
          "geometry_variants",
          "request_schemas",
          "intent_constraints",
          "data_nature",
          "production_enabled",
          "notice",
          "licenses",
          "internal_field_names"
        ],
        "properties": {
          "id": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "version": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
          },
          "implementation": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
          },
          "geometry_variants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/geometryVariant"
            }
          },
          "routes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "create-template",
                "generate-map"
              ]
            }
          },
          "request_schemas": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "create-template": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              },
              "generate-map": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
              }
            }
          },
          "data_nature": {
            "type": "string",
            "minLength": 1
          },
          "production_enabled": {
            "const": false
          },
          "notice": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "licenses": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
            }
          },
          "output_profile": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "width_mm",
              "height_mm",
              "dpi",
              "width_px",
              "height_px"
            ],
            "properties": {
              "width_mm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "height_mm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "dpi": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "width_px": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "height_px": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              }
            }
          },
          "output_constraints": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_width_mm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "max_height_mm": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "min_dpi": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "max_dpi": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "allowed_formats": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "pdf",
                    "png",
                    "svg"
                  ]
                }
              },
              "cmyk_supported": {
                "type": "boolean"
              }
            }
          },
          "layout_constraints": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "allowed_models": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "grid",
                    "freeform",
                    "image-native",
                    "fixed-page"
                  ]
                }
              },
              "grid": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "max_rows": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  },
                  "max_columns": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 20
                  },
                  "allowed_shapes": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "pattern": "^\\d+[×x]\\d+$"
                    }
                  },
                  "legend_placements": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "outside",
                        "inside"
                      ]
                    }
                  }
                }
              },
              "freeform": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "max_frames": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 50
                  },
                  "allow_overlap": {
                    "type": "boolean"
                  },
                  "allow_inset": {
                    "type": "boolean"
                  },
                  "frame_types": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "map",
                        "chart",
                        "table",
                        "image",
                        "diagram",
                        "title",
                        "source",
                        "legend",
                        "decorative",
                        "marginalia"
                      ]
                    }
                  }
                }
              }
            }
          },
          "internal_field_names": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "intent_constraints": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "business_scene",
              "allowed_theme_tags",
              "required_theme_tags",
              "allowed_tasks"
            ],
            "properties": {
              "business_scene": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/businessSceneId"
              },
              "allowed_theme_tags": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/themeTags"
              },
              "required_theme_tags": {
                "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/themeTags"
              },
              "allowed_tasks": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
                }
              }
            }
          }
        },
        "allOf": [
          {
            "description": "A profile that admits a route must register the request schema for it; a profile without routes admits both, so both schemas stay required.",
            "if": {
              "properties": {
                "routes": {
                  "contains": {
                    "const": "create-template"
                  }
                }
              },
              "required": [
                "routes"
              ]
            },
            "then": {
              "properties": {
                "request_schemas": {
                  "required": [
                    "create-template"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "routes": {
                  "contains": {
                    "const": "generate-map"
                  }
                }
              },
              "required": [
                "routes"
              ]
            },
            "then": {
              "properties": {
                "request_schemas": {
                  "required": [
                    "generate-map"
                  ]
                }
              }
            }
          },
          {
            "description": "Routes absent defaults to both routes in scenario_registry, so both request schemas must be present.",
            "if": {
              "not": {
                "required": [
                  "routes"
                ]
              }
            },
            "then": {
              "properties": {
                "request_schemas": {
                  "required": [
                    "create-template",
                    "generate-map"
                  ]
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "geometry": {
      "enum": [
        "raster",
        "vector"
      ]
    },
    "rendererId": {
      "enum": [
        "rasterio-matplotlib-page",
        "matplotlib-vector-page",
        "image-itinerary-page"
      ]
    },
    "templateIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "const": "map-scenario"
        },
        "id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "version": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
        }
      }
    },
    "geometryVariant": {
      "description": "Geometry is a data-adaptation attribute of one capability, never a second registration of the same business purpose. Each variant carries only what actually differs per geometry.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry",
        "template",
        "authoring_profile",
        "renderer_id"
      ],
      "properties": {
        "geometry": {
          "$ref": "#/$defs/geometry"
        },
        "template": {
          "$ref": "#/$defs/templateIdentity"
        },
        "authoring_profile": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "renderer_id": {
          "$ref": "#/$defs/rendererId"
        }
      }
    }
  }
}
