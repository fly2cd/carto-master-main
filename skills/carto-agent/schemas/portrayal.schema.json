{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/portrayal.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "layers", "legend", "rules"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "layers": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "data_role", "geometry", "z_order", "symbol"], "properties": {
      "id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
      "data_role": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
      "geometry": {"enum": ["point", "line", "polygon", "raster"]},
      "z_order": {"type": "integer", "minimum": -1000, "maximum": 1000},
      "symbol": {"type": "object", "required": ["catalog_ref"], "properties": {"catalog_ref": {"type": "string", "minLength": 1}, "parameters": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}}}, "additionalProperties": false},
      "classification": {"type": "object", "additionalProperties": false, "required": ["method", "classes"], "properties": {"method": {"enum": ["equal-interval", "quantile", "jenks", "manual", "categorical"]}, "classes": {"type": "integer", "minimum": 2, "maximum": 12}, "field": {"type": "string"}}},
      "label": {"type": "object", "additionalProperties": false, "required": ["field", "priority"], "properties": {"field": {"type": "string"}, "priority": {"type": "integer", "minimum": 0, "maximum": 100}}},
      "no_data": {"enum": ["explicit-symbol", "transparent", "omit-with-note"]}
    }}}
    ,"legend": {"type": "object", "additionalProperties": false, "required": ["generated_from_layers", "show_no_data"], "properties": {"generated_from_layers": {"type": "boolean"}, "show_no_data": {"type": "boolean"}}},
    "rules": {"type": "array", "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/rule"}}
  }
}
