{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/template-create-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "kind",
    "namespace",
    "template_id",
    "version",
    "profile",
    "purpose",
    "audience",
    "reuse_intent",
    "supported_uses",
    "excluded_uses",
    "authoring_mode",
    "targets",
    "scope",
    "subject",
    "source_manifest_path",
    "data_nature",
    "contains_production_data",
    "contains_sensitive_coordinates",
    "source_crs",
    "display_crs",
    "role_bindings",
    "decisions",
    "requested_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"
    },
    "request_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "kind": {
      "enum": [
        "map-brand",
        "map-style",
        "map-layout",
        "map-scenario"
      ]
    },
    "namespace": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "template_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"
    },
    "profile": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "purpose": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "audience": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "reuse_intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "supported_uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
      }
    },
    "excluded_uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
      }
    },
    "authoring_mode": {
      "enum": [
        "standard",
        "fidelity",
        "mirror"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "svg",
          "pdf",
          "png"
        ]
      }
    },
    "scope": {
      "type": "string",
      "pattern": "^project:[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "maxLength": 128
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "project_id",
        "requester_subject_id",
        "approver_subject_id",
        "environment"
      ],
      "properties": {
        "tenant_id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "project_id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "requester_subject_id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "approver_subject_id": {
          "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
        },
        "environment": {
          "enum": [
            "local",
            "test",
            "staging",
            "production"
          ]
        }
      }
    },
    "source_manifest_path": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/relativePath"
    },
    "data_nature": {
      "type": "string",
      "minLength": 1
    },
    "contains_production_data": {
      "type": "boolean"
    },
    "contains_sensitive_coordinates": {
      "type": "boolean"
    },
    "source_crs": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/crs"
    },
    "display_crs": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/crs"
    },
    "role_bindings": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "value",
          "source_ref"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 256
          },
          "value": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "maxItems": 50,
                "items": {
                  "type": [
                    "string",
                    "number",
                    "boolean"
                  ]
                }
              }
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "requested_at": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"
    }
  }
}
