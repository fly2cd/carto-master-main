{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/validation-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "report_id", "phase", "subject_digest", "status", "results", "created_at"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "report_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "phase": {"enum": ["intake", "validate", "plan", "preview", "approval", "final-check", "delivery"]},
    "subject_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "subject_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"},
    "checker_set_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "checked_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "artifact_ref", "size_bytes", "media_type"],
        "properties": {
          "target": {"enum": ["svg", "png", "pdf"]},
          "artifact_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"},
          "size_bytes": {"type": "integer", "minimum": 1},
          "media_type": {"enum": ["image/svg+xml", "image/png", "application/pdf"]}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocker", "error", "warning", "info", "failed_blocker", "failed_error", "failed_warning"],
      "properties": {
        "blocker": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "warning": {"type": "integer", "minimum": 0},
        "info": {"type": "integer", "minimum": 0},
        "failed_blocker": {"type": "integer", "minimum": 0},
        "failed_error": {"type": "integer", "minimum": 0},
        "failed_warning": {"type": "integer", "minimum": 0}
      }
    },
    "status": {"enum": ["passed", "failed"]},
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "version", "status", "severity", "details"],
        "properties": {
          "check_id": {"type": "string", "minLength": 1},
          "version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"},
          "status": {"enum": ["passed", "failed"]},
          "severity": {"enum": ["blocker", "error", "warning", "info"]},
          "disposition": {"enum": ["accepted", "fix-and-recheck", "blocked"]},
          "details": {"type": "object"}
        },
        "allOf": [
          {
            "if": {"properties": {"severity": {"const": "warning"}}, "required": ["severity"]},
            "then": {"required": ["disposition"]}
          }
        ]
      }
    },
    "created_at": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"}
  },
  "allOf": [
    {
      "if": {"properties": {"phase": {"const": "final-check"}}, "required": ["phase"]},
      "then": {"required": ["subject_ref", "checker_set_digest", "checked_artifacts", "counts"]}
    }
  ]
}