{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/environment-fingerprint.schema.json",
  "title": "Renderer environment fingerprint and capability handshake",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "probe_id", "status", "platform", "python_version", "tools", "chinese_fonts", "capabilities", "probed_at", "fingerprint"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "probe_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "status": {"enum": ["available", "unavailable"]},
    "platform": {"type": "string", "minLength": 1},
    "python_version": {"type": "string", "minLength": 1},
    "tools": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/tool"},
      "minProperties": 1
    },
    "chinese_fonts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["webgl_available", "offline_rendering", "svg_composition", "headless_export", "chinese_font"],
      "properties": {
        "webgl_available": {"type": "boolean"},
        "offline_rendering": {"type": "boolean"},
        "svg_composition": {"type": "boolean"},
        "headless_export": {"type": "boolean"},
        "chinese_font": {"type": "boolean"},
        "max_canvas_width": {"type": "integer", "minimum": 1},
        "max_canvas_height": {"type": "integer", "minimum": 1},
        "supported_export_formats": {"type": "array", "items": {"enum": ["svg", "pdf", "png"]}, "uniqueItems": true}
      }
    },
    "renderer_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer_id", "frontend_build", "renderer_version", "maplibre_version", "overlay_engine_version", "browser_engine", "webgl_available", "supported_export_formats", "max_canvas_width", "max_canvas_height", "device_pixel_ratio", "available_fonts", "offline_rendering"],
      "properties": {
        "renderer_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$", "minLength": 1},
        "frontend_build": {"type": "string", "minLength": 1},
        "renderer_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"},
        "maplibre_version": {"type": "string", "minLength": 1},
        "overlay_engine_version": {"type": "string", "minLength": 1},
        "browser_engine": {"type": "string", "minLength": 1},
        "webgl_available": {"type": "boolean"},
        "supported_export_formats": {"type": "array", "items": {"enum": ["svg", "pdf", "png"]}, "uniqueItems": true},
        "max_canvas_width": {"type": "integer", "minimum": 1},
        "max_canvas_height": {"type": "integer", "minimum": 1},
        "device_pixel_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 4},
        "available_fonts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "offline_rendering": {"type": "boolean"}
      }
    },
    "probed_at": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"},
    "fingerprint": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "error": {"type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}}}
  },
  "$defs": {
    "tool": {"type": "object", "additionalProperties": false, "required": ["available", "executable", "version", "exit_code"], "properties": {"available": {"type": "boolean"}, "command": {"type": ["string", "null"]}, "executable": {"type": ["string", "null"]}, "version": {"type": ["string", "null"]}, "exit_code": {"type": ["integer", "null"]}, "error": {"type": "string"}}}
  }
}
