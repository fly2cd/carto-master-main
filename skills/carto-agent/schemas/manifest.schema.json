{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package", "files", "checksums"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["namespace", "kind", "id", "version", "status", "summary"],
      "properties": {
        "namespace": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
        "kind": {"enum": ["map-brand", "map-style", "map-layout", "map-scenario"]},
        "id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
        "version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/semanticVersion"},
        "status": {"enum": ["draft", "validated", "published"]},
        "summary": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    },
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/templateRef"}},
    "targets": {"type": "array", "uniqueItems": true, "items": {"enum": ["pdf", "png", "qgis-preview"]}},
    "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/relativePath"}},
    "checksums": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/relativePath"}, "additionalProperties": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"}}
  }
}
