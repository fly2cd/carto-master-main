{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/delivery-receipt.schema.json",
  "title": "Immutable post-commit delivery receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "delivery_id",
    "transaction_id",
    "manifest_ref",
    "manifest_digest",
    "idempotency_key",
    "final_path",
    "artifacts",
    "g3_approval_ref",
    "status",
    "delivered_at"
  ],
  "properties": {
    "schema_version": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"
    },
    "receipt_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "delivery_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "transaction_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "manifest_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "manifest_digest": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "final_path": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/relativePath"
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "format", "digest", "size_bytes"],
        "properties": {
          "path": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/relativePath"
          },
          "format": {"enum": ["pdf", "png"]},
          "digest": {
            "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"
          },
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      },
      "contains": {
        "type": "object",
        "required": ["format"],
        "properties": {"format": {"const": "pdf"}}
      },
      "minContains": 1,
      "maxContains": 1,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["format"],
            "properties": {"format": {"const": "png"}}
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "g3_approval_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "status": {"const": "committed"},
    "delivered_at": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"
    }
  }
}