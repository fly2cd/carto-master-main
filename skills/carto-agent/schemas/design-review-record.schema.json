{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/design-review-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "run_id",
    "project_id",
    "candidate_ref",
    "preview_evidence_ref",
    "approval",
    "reviewed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "review_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "run_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "project_id": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"
    },
    "candidate_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "preview_evidence_ref": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"
    },
    "findings": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "summary"
        ],
        "properties": {
          "severity": {
            "enum": ["blocker", "error", "warning", "info"]
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "disposition": {
            "enum": ["resolved", "accepted", "deferred"]
          }
        }
      }
    },
    "approval": {
      "$ref": "https://schemas.carto-agent.local/v1/approval-receipt.schema.json"
    },
    "reviewed_at": {
      "$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"
    }
  }
}
