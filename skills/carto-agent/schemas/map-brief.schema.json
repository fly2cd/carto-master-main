{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.carto-agent.local/v1/map-brief.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "brief_id", "revision", "intent_ref", "purpose", "audience", "source_plan", "targets", "template_candidates", "delegation", "approval_required"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "brief_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "revision": {"type": "integer", "minimum": 1},
    "intent_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"},
    "purpose": {"type": "string", "minLength": 1}, "audience": {"type": "string", "minLength": 1},
    "source_plan": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["role", "source_ref", "allowed_operations"], "properties": {"role": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}, "source_ref": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"}, "allowed_operations": {"type": "array", "items": {"enum": ["read", "filter", "join", "reproject", "classify", "route"]}, "uniqueItems": true}}}},
    "targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["pdf", "png"]}},
    "template_candidates": {"type": "array", "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/templateRef"}},
    "delegation": {"type": "object", "additionalProperties": false, "required": ["allow_data_agent", "max_tool_calls"], "properties": {"allow_data_agent": {"type": "boolean"}, "max_tool_calls": {"type": "integer", "minimum": 0, "maximum": 100}}},
    "approval_required": {"const": true}
  }
}
