{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.carto-agent.local/v1/draft-import-record.schema.json",
  "description": "A->B deferred publication import receipt (design §8.4). Records that publication run B imported finished creation run A's immutable draft and validation evidence by digest. It references the original draft/evidence; it never copies or re-signs A's step receipts, and A is not modified. B re-authors under its own final identity and produces its own validation evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "import_id",
    "source_run_id",
    "source_draft_digest",
    "source_evidence_digest",
    "source_evidence_id",
    "imported_design_digest",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "import_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "source_run_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "source_draft_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "source_evidence_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "source_evidence_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "imported_design_digest": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/digest"},
    "created_at": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/timestamp"}
  }
}