{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://schemas.carto-agent.local/v1/data-preparation-task.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "task_id", "required_roles", "allowed_sources", "allowed_operations", "budget", "acceptance_checks"],
  "properties": {
    "schema_version": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/schemaVersion"},
    "task_id": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"},
    "required_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}},
    "allowed_sources": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/artifactRef"}},
    "allowed_operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["filter", "join", "reproject", "aggregate", "classify", "route"]}},
    "budget": {"type": "object", "additionalProperties": false, "required": ["max_tool_calls", "max_seconds"], "properties": {"max_tool_calls": {"type": "integer", "minimum": 1, "maximum": 100}, "max_seconds": {"type": "integer", "minimum": 1, "maximum": 3600}}},
    "acceptance_checks": {"type": "array", "minItems": 1, "items": {"$ref": "https://schemas.carto-agent.local/v1/common.schema.json#/$defs/identifier"}}
  }
}
